# Supabase — proyecto del cliente
# Crear en https://supabase.com → New project (ver README.md, sección "Puesta en marcha")
# Las claves van en .env (NO se commitea). Copiar este archivo a .env y completar.

# Project URL — Dashboard → Settings → API → Project URL
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# anon / public key — Dashboard → Settings → API → Project Publishable keys
PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANON

# Nota: NO se usa service_role en este proyecto.
# Toda escritura pasa por las policies de RLS usando la sesión del admin.