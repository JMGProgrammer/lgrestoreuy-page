---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TarjetaPieza from '../../components/TarjetaPieza.astro';
import { getCategorias, getPieces, getSiteSettings } from '../../lib/content';

const categoria = Astro.url.searchParams.get('categoria');
const [categorias, piezas, settings] = await Promise.all([
  getCategorias(),
  getPieces({ categoria: categoria ?? undefined }),
  getSiteSettings(),
]);
---

<BaseLayout
  title="Piezas en venta"
  description="Muebles y antigüedades restaurados por el taller, disponibles para compra. Consultá por WhatsApp."
>
  <section class="mx-auto max-w-6xl px-4 py-14">
    <p class="rotulo">Stock del taller</p>
    <h1 class="mt-2 text-4xl text-tinta sm:text-5xl">Piezas en venta</h1>
    <p class="mt-4 max-w-xl leading-relaxed text-tinta-suave">
      Cada pieza es única. Escribinos por WhatsApp para confirmar disponibilidad,
      medidas exactas y coordinar la entrega.
    </p>

    {
      categorias.length > 1 && (
        <nav class="mt-8 flex flex-wrap gap-2" aria-label="Filtrar por categoría">
          <a
            href="/piezas"
            class:list={[
              'rounded border px-3 py-1.5 text-sm transition-colors',
              !categoria
                ? 'border-nogal bg-nogal text-papel'
                : 'border-linea text-tinta-suave hover:border-latón',
            ]}
          >
            Todas
          </a>
          {categorias.map((cat) => (
            <a
              href={`/piezas?categoria=${encodeURIComponent(cat)}`}
              class:list={[
                'rounded border px-3 py-1.5 text-sm transition-colors',
                categoria === cat
                  ? 'border-nogal bg-nogal text-papel'
                  : 'border-linea text-tinta-suave hover:border-latón',
              ]}
            >
              {cat}
            </a>
          ))}
        </nav>
      )
    }

    <div class="rule-dorada my-10"></div>

    {
      piezas.length === 0 ? (
        <div class="rounded border border-dashed border-linea px-6 py-16 text-center">
          <p class="font-display text-xl text-tinta">
            Todavía no hay piezas publicadas
          </p>
          <p class="mx-auto mt-2 max-w-sm text-sm text-tinta-suave">
            Estamos preparando el stock. Escribinos y te decimos qué hay en el
            taller.
          </p>
          <a href="/contacto" class="btn-secundario mt-6">
            Escribirnos
          </a>
        </div>
      ) : (
        <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {piezas.map((pieza) => (
            <li>
              <TarjetaPieza pieza={pieza} whatsapp={settings.whatsapp} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>