---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { adminContext, listarServicios } from '../../../lib/admin';
import Icon from '../../../components/admin/Icon.astro';

const ctx = adminContext(Astro.request, Astro.cookies);
const servicios = await listarServicios(ctx);

// Los datos viajan como JSON, no como script inline: el panel no permite
// scripts inline (CSP). El "<" escapado evita que un texto rompa el HTML.
const datosJson = JSON.stringify(servicios).replace(/</g, '\\u003c');
---

<AdminLayout
  titulo="Servicios"
  subtitulo="Lo que el cliente ve en la página de servicios. Arrastrá para cambiar el orden."
>
  <script type="application/json" id="datos-servicios" set:html={datosJson} />

  <div x-data="servicios()" x-cloak class="space-y-4">
    <!-- ============ Alta ============ -->
    <div class="ui-despliegue" :data-abierto="creando">
      <div>
        <form
          class="ui-panel space-y-3.5 p-4"
          x-show="creando"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          @submit.prevent="crear()"
        >
          <div class="flex items-center justify-between">
            <p class="ui-seccion-titulo">Nuevo servicio</p>
            <button
              type="button"
              class="ui-btn ui-btn-fantasma ui-btn-sm ui-btn-icono"
              @click="creando = false"
              aria-label="Cerrar"
            >
              <Icon nombre="cruz" />
            </button>
          </div>

          <div>
            <label class="ui-label" for="nuevo-nombre">Nombre</label>
            <input
              id="nuevo-nombre"
              class="ui-campo"
              x-model="form.nombre"
              placeholder="Ej: Tapicería de sillones"
              required
            />
          </div>

          <div>
            <label class="ui-label" for="nuevo-descripcion">Descripción</label>
            <textarea
              id="nuevo-descripcion"
              class="ui-campo"
              x-model="form.descripcion"
              placeholder="Qué incluye y para quién es. Se muestra debajo del nombre."
              rows="3"
            ></textarea>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="ui-label" for="nuevo-min">Precio desde</label>
              <input
                id="nuevo-min"
                class="ui-campo ui-num"
                x-model="form.precio_min"
                placeholder="$ 0"
                inputmode="numeric"
              />
            </div>
            <div>
              <label class="ui-label" for="nuevo-max">Precio hasta</label>
              <input
                id="nuevo-max"
                class="ui-campo ui-num"
                x-model="form.precio_max"
                placeholder="$ 0"
                inputmode="numeric"
              />
            </div>
          </div>

          <p class="ui-ayuda">
            Si lo dejás vacío se publica como “A consultar”.
          </p>

          <p x-show="error" x-text="error" class="ui-error"></p>

          <div class="flex gap-2">
            <button type="submit" class="ui-btn ui-btn-acento" :disabled="guardando">
              <span x-show="!guardando">Agregar</span>
              <span x-show="guardando">Guardando…</span>
            </button>
            <button type="button" class="ui-btn ui-btn-neutro" @click="creando = false">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ============ Lista ============ -->
    <div
      class="ui-panel"
      :class="{ 'ui-zona-foco': ordenando }"
    >
      <div
        class="flex items-center justify-between gap-3 border-b border-ui-borde bg-ui-panel-2 px-3 py-2"
      >
        <p class="ui-seccion-titulo">
          <span x-text="lista.length"></span> servicios ·
          <span x-text="activos()"></span> visibles
        </p>

        <div class="flex items-center gap-2">
          <span
            class="ui-chip ui-chip-info"
            x-show="ordenando"
            x-transition.opacity.duration.150ms
          >
            Reordenando
          </span>

          <button
            type="button"
            class="ui-btn ui-btn-primario ui-btn-sm"
            @click="abrirNuevo()"
            x-show="!creando"
          >
            <Icon nombre="mas" clase="size-4" />
            Nuevo
          </button>
        </div>
      </div>

      <ul
        class="min-h-16"
        x-ref="lista"
        @dragover.prevent="alMover($event)"
        @drop.prevent="soltar()"
      >
        <template x-for="(s, indice) in lista" :key="s.id">
          <li
            :data-id="s.id"
            class="ui-item border-b border-ui-borde last:border-b-0"
            :class="{
              'ui-item-enfocado': editando === s.id,
              'ui-item-enfocado': senalada === s.id,
              'ui-fila-soltada': idSoltado === s.id,
              'ui-pulso': recienGuardado === s.id,
            }"
          >
            <!-- ============ Fila de lectura ============ -->
            <div
              class="ui-fila !border-b-0"
              :class="{
                'guardando': guardandoId === s.id,
                'ui-fila-senalada': senalada === s.id,
                'ui-fila-arrastrando': arrastrando === s.id,
              }"
              draggable="true"
              @dragstart="arrastrar($event, s.id)"
              @dragend="terminarArrastre()"
            >
              <div class="ui-progreso" x-show="guardandoId === s.id" aria-hidden="true">
              </div>

              <span class="ui-asa shrink-0 select-none" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <circle cx="9" cy="6" r="1.5" /><circle cx="15" cy="6" r="1.5" />
                  <circle cx="9" cy="12" r="1.5" /><circle cx="15" cy="12" r="1.5" />
                  <circle cx="9" cy="18" r="1.5" /><circle cx="15" cy="18" r="1.5" />
                </svg>
              </span>

              <!-- Nombre + precio: una sola línea, el texto no se parte -->
              <div class="min-w-0 flex-1">
                <p class="flex items-center gap-2">
                  <span class="ui-truncate text-sm font-medium text-ui-texto" x-text="s.nombre"></span>
                  <span x-show="!s.activo" class="ui-chip ui-chip-neutro shrink-0">oculto</span>
                  <span
                    x-show="s.activo && (s.precio_min === null || s.precio_max === null)"
                    class="ui-chip ui-chip-alerta shrink-0"
                  >sin precio</span>
                </p>
                <p
                  class="ui-num mt-0.5 whitespace-nowrap"
                  :class="s.precio_min === null && s.precio_max === null
                    ? 'text-ui-texto-3 italic'
                    : 'text-ui-texto-2'"
                  x-text="precio(s)"
                >
                </p>
              </div>

              <div class="flex shrink-0 items-center gap-1">
                <button
                  type="button"
                  class="ui-switch"
                  @click="alternar(s)"
                  :aria-label="s.activo ? 'Ocultar de la web' : 'Mostrar en la web'"
                  :aria-pressed="s.activo"
                >
                  <span class="ui-switch-mando"></span>
                </button>

                <button
                  type="button"
                  class="ui-btn ui-btn-fantasma ui-btn-sm ui-btn-icono ui-accion"
                  @click="empezarEdicion(s)"
                  :disabled="editando !== null"
                  aria-label="Editar"
                  x-show="editando === null"
                >
                  <Icon nombre="lapiz" />
                </button>

                <button
                  type="button"
                  class="ui-btn ui-btn-peligro ui-btn-sm ui-btn-icono ui-accion"
                  @click="eliminar(s, indice)"
                  :disabled="editando !== null"
                  aria-label="Eliminar"
                  x-show="editando === null"
                >
                  <Icon nombre="tacho" />
                </button>
              </div>
            </div>

            <!-- ============ Editor: a ancho completo, debajo ============ -->
            <div
              class="ui-editor"
              x-show="editando === s.id"
              x-cloak
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 -translate-y-1"
              x-transition:enter-end="opacity-100 translate-y-0"
            >
              <div class="space-y-3.5">
                <div>
                  <label
                    class="ui-label"
                    :class="{ 'ui-label-cambiada': cambio('nombre') }"
                    :for="`nombre-${s.id}`"
                  >
                    Nombre
                  </label>
                  <input
                    class="ui-campo"
                    :class="{ 'ui-campo-cambiado': cambio('nombre') }"
                    :id="`nombre-${s.id}`"
                    x-model="borrador.nombre"
                  />
                </div>

                <div>
                  <label
                    class="ui-label"
                    :class="{ 'ui-label-cambiada': cambio('descripcion') }"
                    :for="`desc-${s.id}`"
                  >
                    Descripción
                  </label>
                  <textarea
                    class="ui-campo"
                    :class="{ 'ui-campo-cambiado': cambio('descripcion') }"
                    :id="`desc-${s.id}`"
                    x-model="borrador.descripcion"
                    rows="3"
                    placeholder="Qué incluye y para quién es."
                  ></textarea>
                </div>

                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label
                      class="ui-label"
                      :class="{ 'ui-label-cambiada': cambio('precio_min') }"
                      :for="`min-${s.id}`"
                    >
                      Precio desde
                    </label>
                    <input
                      class="ui-campo ui-num"
                      :class="{ 'ui-campo-cambiado': cambio('precio_min') }"
                      :id="`min-${s.id}`"
                      x-model="borrador.precio_min"
                      placeholder="vacío"
                      inputmode="numeric"
                    />
                  </div>
                  <div>
                    <label
                      class="ui-label"
                      :class="{ 'ui-label-cambiada': cambio('precio_max') }"
                      :for="`max-${s.id}`"
                    >
                      Precio hasta
                    </label>
                    <input
                      class="ui-campo ui-num"
                      :class="{ 'ui-campo-cambiado': cambio('precio_max') }"
                      :id="`max-${s.id}`"
                      x-model="borrador.precio_max"
                      placeholder="vacío"
                      inputmode="numeric"
                    />
                  </div>
                </div>
              </div>

              <div class="ui-editor-barra">
                <span class="ui-sin-guardar" x-show="hayCambios()">
                  <span x-text="`${camposCambiados().length} ${camposCambiados().length === 1 ? 'campo editado' : 'campos editados'} sin guardar`"></span>
                </span>
                <span class="ui-ayuda mt-0" x-show="!hayCambios()">
                  Sin cambios.
                </span>

                <div class="ml-auto flex gap-2">
                  <button
                    type="button"
                    class="ui-btn ui-btn-neutro ui-btn-sm"
                    @click="cancelarEdicion()"
                  >
                    Cancelar
                  </button>
                  <button
                    type="button"
                    class="ui-btn ui-btn-acento ui-btn-sm"
                    @click="guardar()"
                    :disabled="!hayCambios() || guardandoId !== null"
                  >
                    <span x-show="guardandoId === null">Guardar</span>
                    <span x-show="guardandoId !== null">Guardando…</span>
                  </button>
                </div>
              </div>
            </div>
          </li>
        </template>
      </ul>

      <!-- Estado vacío -->
      <div x-show="lista.length === 0" class="ui-vacio" x-cloak>
        <p class="ui-vacio-titulo">Todavía no hay servicios</p>
        <p class="ui-vacio-texto">
          Agregá los trabajos que hacés. Es lo primero que ve el cliente.
        </p>
        <button type="button" class="ui-btn ui-btn-acento" @click="abrirNuevo()">
          <Icon nombre="mas" clase="size-4" />
          Crear el primero
        </button>
      </div>
    </div>

    <p class="text-xs text-ui-texto-3">
      La web muestra los servicios visibles en este orden. Los cambios se ven en
      menos de un minuto.
    </p>
  </div>

  <!-- Velo: atenúa todo lo que no está en foco.
      Tres modos: editando una fila, reordenando toda la lista, o
      confirmando un cambio de visibilidad. -->
  <div
    class="ui-velo"
    :class="{ 'ui-velo-suave': ordenando }"
    x-show="editando !== null || ordenando || senalada !== null"
    x-cloak
    aria-hidden="true"
  ></div>
</AdminLayout>

<script>
  import { Alpine, api, avisarError, avisos, leerDatos } from '../../../scripts/admin';

  interface Servicio {
    id: string;
    nombre: string;
    descripcion: string | null;
    precio_min: number | null;
    precio_max: number | null;
    icono: string | null;
    orden: number;
    activo: boolean;
  }

  type Campo = 'nombre' | 'descripcion' | 'precio_min' | 'precio_max';

  interface Borrador {
    id: string;
    nombre: string;
    descripcion: string;
    precio_min: string;
    precio_max: string;
  }

  const formato = new Intl.NumberFormat('es-UY');

  /**
   * Función nombrada a propósito: así TypeScript infiere el tipo de `this`
   * dentro de los métodos. Con una flecha anónima el tipado se pierde.
   */
  function serviciosEstado() {
    return {
      lista: leerDatos<Servicio[]>('datos-servicios'),
      /** Fila abierta en edición. Una sola a la vez. */
      editando: null as string | null,
      /** Copia de trabajo. La lista nunca cambia hasta guardar. */
      borrador: null as Borrador | null,
      guardando: false,
      guardandoId: null as string | null,
      creando: false,
      /** Reordenando: el foco abarca toda la lista. */
      ordenando: false,
      arrastrando: null as string | null,
      idSoltado: null as string | null,
      /** Fila recién reordenada o con visibilidad cambiada. */
      senalada: null as string | null,
      recienGuardado: null as string | null,
      error: '',

      form: { nombre: '', descripcion: '', precio_min: '', precio_max: '' },

      // -------------------------------------------------- lectura

      servicioActual(): Servicio | null {
        return this.lista.find((s) => s.id === this.editando) ?? null;
      },

      activos() {
        return this.lista.filter((s) => s.activo).length;
      },

      precio(s: Servicio) {
        const { precio_min: min, precio_max: max } = s;
        if (min === null && max === null) return 'A consultar';
        if (min !== null && max !== null)
          return `$${formato.format(min)} – $${formato.format(max)}`;
        if (min !== null) return `Desde $${formato.format(min)}`;
        return `Hasta $${formato.format(max ?? 0)}`;
      },

      // -------------------------------------------------- borrador

      valorGuardado(campo: Campo): string {
        const s = this.servicioActual();
        if (!s) return '';
        if (campo === 'nombre') return s.nombre;
        if (campo === 'descripcion') return s.descripcion ?? '';
        return s[campo]?.toString() ?? '';
      },

      /** Un campo concreto fue tocado respecto de lo guardado. */
      cambio(campo: Campo): boolean {
        if (!this.borrador) return false;
        return this.borrador[campo] !== this.valorGuardado(campo);
      },

      camposCambiados(): Campo[] {
        const campos: Campo[] = [
          'nombre',
          'descripcion',
          'precio_min',
          'precio_max',
        ];
        return campos.filter((campo) => this.cambio(campo));
      },

      hayCambios(): boolean {
        return this.camposCambiados().length > 0;
      },

      // -------------------------------------------------- señalización

      /** Marca una fila un instante: "esto es lo que acaba de cambiar". */
      senalar(id: string) {
        this.senalada = id;
        setTimeout(() => {
          if (this.senalada === id) this.senalada = null;
        }, 1400);
      },

      // -------------------------------------------------- edición

      /**
       * Abrir el editor no toca la lista. Todo lo que se escriba vive en
       * `borrador` y solo se aplica al guardar.
       */
      empezarEdicion(s: Servicio) {
        this.borrador = {
          id: s.id,
          nombre: s.nombre,
          descripcion: s.descripcion ?? '',
          precio_min: s.precio_min?.toString() ?? '',
          precio_max: s.precio_max?.toString() ?? '',
        };
        this.editando = s.id;
        this.registrarCambiosPendientes(s.nombre);
      },

      cancelarEdicion() {
        this.editando = null;
        this.borrador = null;
        this.limpiarCambiosPendientes();
      },

      async guardar() {
        const s = this.servicioActual();
        if (!s || !this.borrador) return;

        if (!this.borrador.nombre.trim()) {
          avisarError(new Error('El nombre no puede quedar vacío.'));
          return;
        }

        this.guardandoId = s.id;
        try {
          const { servicio } = await api<{ servicio: Servicio }>(
            `/api/admin/servicios/${s.id}`,
            {
              method: 'PATCH',
              body: JSON.stringify({
                nombre: this.borrador.nombre.trim(),
                descripcion: this.borrador.descripcion.trim() || null,
                precio_min: this.borrador.precio_min || null,
                precio_max: this.borrador.precio_max || null,
              }),
            },
          );

          this.limpiarCambiosPendientes();

          // Recién acá la lista refleja el cambio.
          const indice = this.lista.findIndex((x) => x.id === s.id);
          if (indice >= 0) this.lista[indice] = servicio;

          this.cancelarEdicion();

          this.senalar(s.id);
          this.recienGuardado = servicio.id;
          setTimeout(() => {
            if (this.recienGuardado === servicio.id) this.recienGuardado = null;
          }, 900);

          avisos.exito('Cambios guardados');
        } catch (e) {
          avisarError(e);
        } finally {
          this.guardandoId = null;
        }
      },

      // ------------------------------ guard de cambios sin guardar

      /**
       * Avisa al layout que hay un borrador abierto. Si el usuario intenta
       * cambiar de sección o recargar, se ofrece guardar o descartar.
       */
      registrarCambiosPendientes(nombre: string) {
        (Alpine.store('cambios') as {
          registrar: (
            etiqueta: string,
            guardar: () => void | Promise<void>,
            descartar: () => void,
          ) => void;
        }).registrar(
          nombre,
          async () => {
            await this.guardar();
          },
          () => this.cancelarEdicion(),
        );
      },

      limpiarCambiosPendientes() {
        (Alpine.store('cambios') as { limpiar: () => void }).limpiar();
      },

      // -------------------------------------------------- alta

      abrirNuevo() {
        this.error = '';
        this.form = { nombre: '', descripcion: '', precio_min: '', precio_max: '' };
        this.creando = true;
      },

      async crear() {
        this.error = '';
        if (!this.form.nombre.trim()) {
          this.error = 'Poné un nombre.';
          return;
        }

        this.guardando = true;
        try {
          const { servicio } = await api<{ servicio: Servicio }>(
            '/api/admin/servicios',
            {
              method: 'POST',
              body: JSON.stringify({
                nombre: this.form.nombre.trim(),
                descripcion: this.form.descripcion.trim() || null,
                precio_min: this.form.precio_min || null,
                precio_max: this.form.precio_max || null,
                orden: this.lista.length,
              }),
            },
          );

          this.lista.push(servicio);
          this.creando = false;
          avisos.exito('Servicio agregado');
        } catch (e) {
          this.error = e instanceof Error ? e.message : 'No se pudo crear.';
        } finally {
          this.guardando = false;
        }
      },

      // -------------------------------------------------- acciones de fila

      /**
       * El interruptor es una acción de un toque con su propio guardado, así
       * que responde al instante. Si falla, vuelve atrás.
       */
      async alternar(s: Servicio) {
        const anterior = s.activo;
        s.activo = !s.activo;
        this.senalar(s.id);

        try {
          await api(`/api/admin/servicios/${s.id}`, {
            method: 'PATCH',
            body: JSON.stringify({ activo: s.activo }),
          });
          avisos.exito(s.activo ? 'Visible en la web' : 'Oculto de la web');
        } catch (e) {
          s.activo = anterior;
          avisarError(e);
        }
      },

      async eliminar(s: Servicio, indice: number) {
        if (this.editando === s.id) this.cancelarEdicion();

        const copia = JSON.parse(JSON.stringify(s));
        this.lista.splice(indice, 1);

        try {
          await api(`/api/admin/servicios/${s.id}`, { method: 'DELETE' });

          avisos.mostrar(`Se eliminó “${copia.nombre}”`, 'ok', {
            texto: 'Deshacer',
            fn: () => this.restaurar(copia, indice),
          });
        } catch (e) {
          this.lista.splice(indice, 0, copia);
          avisarError(e);
        }
      },

      async restaurar(s: Servicio, indice: number) {
        try {
          const { servicio } = await api<{ servicio: Servicio }>(
            '/api/admin/servicios',
            {
              method: 'POST',
              body: JSON.stringify({
                nombre: s.nombre,
                descripcion: s.descripcion,
                precio_min: s.precio_min,
                precio_max: s.precio_max,
                icono: s.icono,
                orden: s.orden,
                activo: s.activo,
              }),
            },
          );

          this.lista.splice(indice, 0, servicio);
          avisos.exito('Servicio restaurado');
        } catch (e) {
          avisarError(e);
        }
      },

      // -------------------------------------------------- arrastre

      /**
       * Ordenamiento en vivo. Mientras se arrastra no se toca la lista: las
       * filas vecinas se desplazan con un transform para mostrar de antemano
       * cuál sube y cuál baja. Al soltar, la lista se reordena de una vez y
       * las filas se animan desde su posición anterior hasta la nueva.
       */

      /**
       * Alpine inyecta $refs y $nextTick en tiempo de ejecución; el tipo del
       * objeto literal no los conoce, así que se llega a ellos por acá.
       */
      magics(): {
        $refs: Record<string, HTMLElement | undefined>;
        $nextTick: () => Promise<void>;
      } {
        return this as unknown as {
          $refs: Record<string, HTMLElement | undefined>;
          $nextTick: () => Promise<void>;
        };
      },

      listaEl(): HTMLElement | undefined {
        return this.magics().$refs.lista;
      },

      /**
       * Índice que tenía la fila cuando empezó el arrastre.
       * Se usa para decidir si el puntero está "antes" o "después" de ella.
       */
      indiceOrigen: -1,

      /**
       * Calcula en qué posición caería el servicio según dónde esté el
       * puntero, y lo mueve ahí mismo.
       *
       * El puntero se compara contra el centro de cada fila, no contra la
       * fila que tiene debajo: así el destino depende de la posición real del
       * cursor y no de "la fila que estás tocando". Por eso funciona igual
       * para subir que para bajar.
       */
      alMover(evento: DragEvent) {
        const id = this.arrastrando;
        if (id === null) return;

        const lista = this.listaEl();
        if (!lista) return;

        const filas = Array.from(
          lista.querySelectorAll<HTMLElement>('[data-id]'),
        );

        const actual = this.lista.findIndex((s) => s.id === id);
        if (actual < 0) return;

        // Cuántas filas hay "por encima" del punto donde caería.
        const sobreElCurso = filas.filter((fila) => {
          const caja = fila.getBoundingClientRect();
          // Si el puntero está en la mitad superior de la fila, va antes.
          return evento.clientY < caja.top + caja.height / 2;
        }).length;

        // `sobreElCurso` cuenta también la fila que se arrastra; hay que
        // sacarla porque va a cambiar de lugar.
        const dragged = filas.findIndex((f) => f.dataset.id === id);
        const destino = sobreElCurso > dragged ? sobreElCurso - 1 : sobreElCurso;

        if (destino === actual) return;

        this.moverA(destino);
      },

      /** Reordena la lista localmente y anima el desplazamiento. */
      async moverA(destino: number) {
        const id = this.arrastrando;
        if (id === null) return;

        const lista = this.listaEl();
        const actual = this.lista.findIndex((s) => s.id === id);
        if (actual < 0 || actual === destino) return;

        // 1. Medir dónde está cada fila ANTES de tocar nada.
        const antes = new Map<string, number>();
        lista
          ?.querySelectorAll<HTMLElement>('[data-id]')
          .forEach((fila) => {
            antes.set(fila.dataset.id ?? '', fila.getBoundingClientRect().top);
          });

        // 2. Reordenar.
        const [movido] = this.lista.splice(actual, 1);
        this.lista.splice(destino, 0, movido);

        // 3. Esperar al redibujado y animar desde la posición anterior: eso es
        //    lo que da la sensación de que la lista acompaña al cursor.
        await this.magics().$nextTick();

        lista
          ?.querySelectorAll<HTMLElement>('[data-id]')
          .forEach((fila) => {
            const previa = antes.get(fila.dataset.id ?? '');
            if (previa === undefined) return;

            const delta = previa - fila.getBoundingClientRect().top;
            if (Math.abs(delta) < 1) return;

            fila.animate(
              [
                { transform: `translateY(${delta}px)` },
                { transform: 'translateY(0)' },
              ],
              { duration: 200, easing: 'cubic-bezier(0.2, 0, 0, 1)' },
            );
          });
      },

      arrastrar(evento: DragEvent, id: string) {
        if (this.editando !== null) return;

        this.arrastrando = id;
        this.indiceOrigen = this.lista.findIndex((s) => s.id === id);

        // El foco pasa a ser la lista entera: se atenúa el resto de la página
        // mientras se organiza.
        this.ordenando = true;

        evento.dataTransfer?.setData('text/plain', id);
        if (evento.dataTransfer) {
          evento.dataTransfer.effectAllowed = 'move';

          // Sin esto el cursor muestra un rectángulo transparente.
          const fila = this.listaEl()?.querySelector('.ui-fila');
          if (fila) evento.dataTransfer.setDragImage(fila, 20, 20);
        }
      },

      async soltar() {
        const id = this.arrastrando;
        if (id === null) return;

        const ordenFinal = this.lista.map((s) => s.id);
        this.terminarArrastre();

        try {
          await api('/api/admin/servicios', {
            method: 'PATCH',
            body: JSON.stringify({ ordenes: ordenFinal }),
          });

          this.senalar(id);
        } catch (e) {
          avisarError(e);
        }
      },

      terminarArrastre() {
        this.arrastrando = null;
        this.ordenando = false;
        this.indiceOrigen = -1;
      },
    };
  }

  Alpine.data('servicios', serviciosEstado);
</script>