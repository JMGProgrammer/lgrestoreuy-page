---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  adminContext,
  actualizarServicio,
  borrarServicio,
  listarServicios,
  numeroONull,
  textoONull,
} from '../../../lib/admin';
import { formatPriceRange } from '../../../lib/whatsapp';

const ctx = adminContext(Astro.request, Astro.cookies);
const id = Astro.params.id ?? '';

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = String(form.get('_accion') ?? 'guardar');

  if (accion === 'eliminar') {
    try {
      await borrarServicio(ctx, id);
      return Astro.redirect('/admin/servicios?ok=eliminado');
    } catch (e) {
      error = e instanceof Error ? e.message : 'No se pudo eliminar.';
    }
  } else {
    const nombre = String(form.get('nombre') ?? '').trim();
    if (!nombre) {
      error = 'El servicio necesita un nombre.';
    } else {
      try {
        await actualizarServicio(ctx, id, {
          nombre,
          descripcion: textoONull(form.get('descripcion')),
          precio_min: numeroONull(form.get('precio_min')),
          precio_max: numeroONull(form.get('precio_max')),
          icono: textoONull(form.get('icono')),
          orden: numeroONull(form.get('orden')) ?? 0,
          activo: form.get('activo') === 'on',
        });
        return Astro.redirect('/admin/servicios?ok=guardado');
      } catch (e) {
        error = e instanceof Error ? e.message : 'No se pudo guardar.';
      }
    }
  }
}

const servicios = await listarServicios(ctx);
const servicio = servicios.find((s) => s.id === id);

if (!servicio) {
  return Astro.redirect('/admin/servicios');
}

const ok = Astro.url.searchParams.get('ok');
---

<AdminLayout titulo={servicio.nombre}>
  <a
    href="/admin/servicios"
    class="text-xs text-tinta-suave underline decoration-latón underline-offset-4 hover:text-tinta"
  >
    ← Todos los servicios
  </a>

  <p class="mt-3 text-sm text-tinta-suave">
    Ahora en la web: {formatPriceRange(servicio.precio_min, servicio.precio_max)}
    {servicio.activo ? '' : '· oculto (inactivo)'}
  </p>

  {
    error && (
      <p class="mt-4 rounded border border-[#9a2f2f] bg-[#9a2f2f]/10 px-4 py-3 text-sm text-[#7a2626]">
        {error}
      </p>
    )
  }

  {
    ok && (
      <p class="mt-4 rounded border border-[#4f6b46] bg-[#4f6b46]/10 px-4 py-3 text-sm text-[#33472e]">
        Guardado.
      </p>
    )
  }

  <form method="post" class="mt-6 max-w-2xl space-y-4">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="campo-label" for="nombre">Nombre</label>
        <input class="campo" id="nombre" name="nombre" value={servicio.nombre} required />
      </div>
      <div>
        <label class="campo-label" for="orden">Orden en la web</label>
        <input class="campo" id="orden" name="orden" type="number" min="0" value={servicio.orden} />
      </div>
    </div>

    <div>
      <label class="campo-label" for="descripcion">Descripción</label>
      <textarea class="campo" id="descripcion" name="descripcion" rows="4">{servicio.descripcion ?? ''}</textarea>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="campo-label" for="precio_min">Precio desde (UYU)</label>
        <input
          class="campo"
          id="precio_min"
          name="precio_min"
          inputmode="numeric"
          value={servicio.precio_min ?? ''}
          placeholder="vacío = a consultar"
        />
      </div>
      <div>
        <label class="campo-label" for="precio_max">Precio hasta (UYU)</label>
        <input
          class="campo"
          id="precio_max"
          name="precio_max"
          inputmode="numeric"
          value={servicio.precio_max ?? ''}
          placeholder="vacío = a consultar"
        />
      </div>
    </div>

    <label class="flex items-center gap-2 text-sm text-tinta-suave">
      <input type="checkbox" name="activo" checked={servicio.activo} class="accent-[#a8763e]" />
      Visible en la web
    </label>

    <button type="submit" class="btn-principal">Guardar cambios</button>
  </form>

  <form method="post" class="mt-10 border-t border-linea pt-6">
    <input type="hidden" name="_accion" value="eliminar" />
    <p class="text-sm text-tinta-suave">
      Eliminar este servicio de la web.
    </p>
    <button
      type="submit"
      class="mt-3 rounded border border-[#9a2f2f] px-4 py-2 text-sm text-[#9a2f2f] transition-colors hover:bg-[#9a2f2f]/10"
      data-confirm="¿Eliminar este servicio? No se puede deshacer."
      data-confirm-ok="Eliminar"
      data-confirm-peligro
    >
      Eliminar servicio
    </button>
  </form>
</AdminLayout>