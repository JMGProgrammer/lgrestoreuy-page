---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  adminContext,
  ESTADOS_PIEZA,
  agregarFotoPieza,
  borrarFotoPieza,
  leerContenido,
  listarFotosPieza,
  numeroONull,
  subirImagen,
  textoONull,
} from '../../../lib/admin';
import { getCurrentUser } from '../../../lib/supabase/server';
import { formatUYU, pieceInquiryMessage, whatsappLink } from '../../../lib/whatsapp';

const ctx = adminContext(Astro.request, Astro.cookies);
const id = Astro.params.id ?? '';
const usuario = await getCurrentUser(Astro.request, Astro.cookies);

const ESTADOS_VALIDOS = ESTADOS_PIEZA.map((e) => e.valor);

let error = '';
let aviso = '';

if (Astro.request.method === 'POST' && usuario) {
  const form = await Astro.request.formData();
  const accion = String(form.get('_accion') ?? 'guardar');

  if (accion === 'eliminar_foto') {
    const fotoId = String(form.get('foto_id') ?? '');
    if (fotoId) await borrarFotoPieza(ctx, fotoId);
    return Astro.redirect(`/admin/piezas/${id}`);
  }

  if (accion === 'subir_foto') {
    const rol = String(form.get('rol') ?? 'general');
    const archivo = form.get('archivo');

    if (archivo instanceof File && archivo.size > 0) {
      const fotos = await listarFotosPieza(ctx, id);

      try {
        const subida = await subirImagen(ctx, 'piezas', archivo, id);
        await agregarFotoPieza(
          ctx,
          id,
          subida,
          rol === 'antes' || rol === 'despues' ? rol : 'general',
          fotos.length,
        );
      } catch (e) {
        error = e instanceof Error ? e.message : 'No se pudo subir la foto.';
      }
    }

    return Astro.redirect(`/admin/piezas/${id}#fotos`);
  }

  const titulo = String(form.get('titulo') ?? '').trim();
  const precio = numeroONull(form.get('precio'));
  const estadoPedido = String(form.get('estado') ?? 'borrador');

  if (!titulo || !precio || precio <= 0) {
    error = 'El título y el precio de venta son obligatorios.';
  } else {
    const estado = ESTADOS_VALIDOS.includes(estadoPedido as never)
      ? estadoPedido
      : 'borrador';

    const { error: err } = await ctx.supabase
      .from('pieces')
      .update({
        titulo,
        descripcion: textoONull(form.get('descripcion')),
        categoria: textoONull(form.get('categoria')),
        precio,
        costo_compra: numeroONull(form.get('costo_compra')),
        medidas: textoONull(form.get('medidas')),
        ubicacion: textoONull(form.get('ubicacion')),
        estado,
        destacada: form.get('destacada') === 'on',
        en_anillo: form.get('en_anillo') === 'on',
      })
      .eq('id', id);

    if (err) error = err.message;
    else aviso = 'Guardado.';
  }
}

const { data: pieza } = await ctx.supabase
  .from('pieces')
  .select('*')
  .eq('id', id)
  .maybeSingle();

if (!pieza) return Astro.redirect('/admin/piezas');

const fotos = await listarFotosPieza(ctx, id);
const contenido = await leerContenido(ctx);
const wa = whatsappLink(
  contenido.whatsapp,
  pieceInquiryMessage({
    titulo: pieza.titulo,
    precio: pieza.precio,
    url: `${Astro.url.origin}/piezas/${pieza.slug}`,
  }),
);
---

<AdminLayout titulo={pieza.titulo}>
  <a
    href="/admin/piezas"
    class="text-xs text-tinta-suave underline decoration-latón underline-offset-4 hover:text-tinta"
  >
    ← Volver a piezas
  </a>

  {
    error && (
      <p class="mt-4 rounded border border-[#9a2f2f] bg-[#9a2f2f]/10 px-4 py-3 text-sm text-[#7a2626]">
        {error}
      </p>
    )
  }

  {
    aviso && (
      <p class="mt-4 rounded border border-[#4f6b46] bg-[#4f6b46]/10 px-4 py-3 text-sm text-[#33472e]">
        {aviso}
      </p>
    )
  }

  <form method="post" class="mt-6 max-w-2xl space-y-5">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="campo-label" for="titulo">Título</label>
        <input class="campo" id="titulo" name="titulo" value={pieza.titulo} required />
      </div>
      <div>
        <label class="campo-label" for="categoria">Categoría</label>
        <input class="campo" id="categoria" name="categoria" value={pieza.categoria ?? ''} />
      </div>
    </div>

    <div>
      <label class="campo-label" for="descripcion">Descripción</label>
      <textarea class="campo" id="descripcion" name="descripcion" rows="4">{pieza.descripcion ?? ''}</textarea>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="campo-label" for="precio">Precio de venta (UYU)</label>
        <input class="campo" id="precio" name="precio" inputmode="numeric" value={pieza.precio} required />
      </div>
      <div>
        <label class="campo-label" for="costo_compra">Costo de compra (UYU)</label>
        <input class="campo" id="costo_compra" name="costo_compra" inputmode="numeric" value={pieza.costo_compra ?? ''} />
        <p class="mt-1 text-xs text-tinta-tenue">Nunca se muestra en la web.</p>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="campo-label" for="medidas">Medidas</label>
        <input class="campo" id="medidas" name="medidas" value={pieza.medidas ?? ''} />
      </div>
      <div>
        <label class="campo-label" for="ubicacion">Ubicación</label>
        <input class="campo" id="ubicacion" name="ubicacion" value={pieza.ubicacion ?? ''} />
      </div>
    </div>

    <div>
      <label class="campo-label" for="estado">Estado</label>
      <select class="campo" id="estado" name="estado">
        {
          ESTADOS_PIEZA.map((estado) => (
            <option value={estado.valor} selected={pieza.estado === estado.valor}>
              {estado.etiqueta}
            </option>
          ))
        }
      </select>
      {
        pieza.estado === 'disponible' && fotos.length === 0 && (
          <p class="mt-1 text-xs text-caoba">
            Se muestra en la web sin foto. Conviene subir al menos una.
          </p>
        )
      }
    </div>

    <label class="flex items-center gap-2 text-sm text-tinta-suave">
      <input type="checkbox" name="destacada" checked={pieza.destacada} class="accent-[#a8763e]" />
      Destacada en la home
    </label>

    <!-- 0006: el anillo 3D del hero. También se marca en Galería → Hero. -->
    <label class="flex items-center gap-2 text-sm text-tinta-suave">
      <input type="checkbox" name="en_anillo" checked={pieza.en_anillo === true} class="accent-[#a8763e]" />
      Girando en el anillo 3D del hero
    </label>

    <button type="submit" class="btn-principal">Guardar</button>
  </form>

  <!-- Fotos -->
  <section id="fotos" class="mt-12 border-t border-linea pt-8">
    <h2 class="text-lg text-tinta">Fotos</h2>

    {
      fotos.length === 0 ? (
        <p class="mt-3 text-sm text-tinta-suave">Sin fotos todavía.</p>
      ) : (
        <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {fotos.map((foto) => (
            <li class="overflow-hidden rounded border border-linea bg-papel">
              <img
                src={foto.url}
                alt=""
                class="aspect-square w-full object-cover"
                loading="lazy"
              />
              <div class="flex items-center justify-between gap-2 px-2 py-1.5">
                <span class="text-xs text-tinta-tenue">{foto.rol}</span>
                <form method="post">
                  <input type="hidden" name="_accion" value="eliminar_foto" />
                  <input type="hidden" name="foto_id" value={foto.id} />
                  <button
                    type="submit"
                    class="text-xs text-[#9a2f2f] underline underline-offset-4"
                  >
                    Quitar
                  </button>
                </form>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    <form
      method="post"
      enctype="multipart/form-data"
      class="mt-6 flex flex-wrap items-end gap-4"
    >
      <input type="hidden" name="_accion" value="subir_foto" />

      <div>
        <label class="campo-label" for="rol">Tipo</label>
        <select class="campo" id="rol" name="rol">
          <option value="general">General (portada)</option>
          <option value="antes">Antes</option>
          <option value="despues">Después</option>
        </select>
      </div>

      <div>
        <label class="campo-label" for="archivo">Imagen</label>
        <input
          class="campo"
          id="archivo"
          name="archivo"
          type="file"
          accept="image/jpeg,image/png,image/webp,image/gif"
        />
      </div>

      <button type="submit" class="btn-secundario">Subir foto</button>
    </form>
  </section>

  <section class="mt-12 border-t border-linea pt-8">
    <h2 class="text-lg text-tinta">En la web</h2>
    <p class="mt-2 text-sm text-tinta-suave">
      Precio publicado: {formatUYU(pieza.precio) ?? 'sin precio'}
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      <a
        href={`/piezas/${pieza.slug}`}
        target="_blank"
        class="btn-secundario"
      >
        Ver la ficha
      </a>
      {
        wa && (
          <a href={wa} target="_blank" rel="noopener noreferrer" class="btn-wa">
            WhatsApp como la ve el cliente
          </a>
        )
      }
    </div>
  </section>
</AdminLayout>