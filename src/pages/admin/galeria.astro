---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  adminContext,
  agregarFotoPieza,
  listarGaleria,
  listarPiezasConFotos,
  numeroONull,
  subirImagen,
  textoONull,
} from '../../lib/admin';
import { getCurrentUser } from '../../lib/supabase/server';
import Icon from '../../components/admin/Icon.astro';

const ctx = adminContext(Astro.request, Astro.cookies);
const usuario = await getCurrentUser(Astro.request, Astro.cookies);

let error = '';

if (Astro.request.method === 'POST' && usuario) {
  const form = await Astro.request.formData();
  const accion = String(form.get('_accion') ?? '');

  if (accion === 'borrar') {
    await ctx.supabase
      .from('gallery_items')
      .delete()
      .eq('id', String(form.get('id') ?? ''));
    return Astro.redirect('/admin/galeria');
  }

  if (accion === 'destacar') {
    await ctx.supabase
      .from('gallery_items')
      .update({ destacada_home: form.get('valor') === 'on' })
      .eq('id', String(form.get('id') ?? ''));
    return Astro.redirect('/admin/galeria');
  }

  if (accion === 'agregar') {
    const pieceId = String(form.get('piece_id') ?? '');
    const antesId = String(form.get('antes_photo_id') ?? '');
    const despuesId = String(form.get('despues_photo_id') ?? '');

    const piezas = await listarPiezasConFotos(ctx);
    const pieza = piezas.find((p) => p.id === pieceId);

    if (!pieza) {
      error = 'Elegí una pieza.';
    } else {
      // Cada lado puede venir de una foto ya subida a la pieza, o de un
      // archivo nuevo subido desde el dispositivo en este mismo formulario.
      const archivoAntes = form.get('foto_antes_archivo');
      const archivoDespues = form.get('foto_despues_archivo');

      const nuevaAntes =
        archivoAntes instanceof File && archivoAntes.size > 0
          ? await subirImagen(ctx, 'piezas', archivoAntes, pieza.id).catch(
              (e: unknown) => {
                error = e instanceof Error ? e.message : 'No se pudo subir la foto.';
                return null;
              },
            )
          : null;

      const nuevaDespues =
        archivoDespues instanceof File && archivoDespues.size > 0
          ? await subirImagen(ctx, 'piezas', archivoDespues, pieza.id).catch(
              (e: unknown) => {
                error = e instanceof Error ? e.message : 'No se pudo subir la foto.';
                return null;
              },
            )
          : null;

      // Si vino una foto nueva se registra como parte de la pieza: no puede
      // quedar huérfana en Storage, y el cliente la ve al editar la pieza.
      const fotoAntesGuardada = nuevaAntes
        ? await agregarFotoPieza(ctx, pieza.id, nuevaAntes, 'antes', pieza.fotos.length)
        : null;

      const fotoDespuesGuardada = nuevaDespues
        ? await agregarFotoPieza(
            ctx,
            pieza.id,
            nuevaDespues,
            'despues',
            pieza.fotos.length + (nuevaAntes ? 1 : 0),
          )
        : null;

      const antes = fotoAntesGuardada ?? pieza.fotos.find((f) => f.id === antesId);
      const despues =
        fotoDespuesGuardada ?? pieza.fotos.find((f) => f.id === despuesId);

      if (!antes || !despues) {
        error = error || 'Elegí la foto de antes y la de después de esa pieza.';
      } else {
        const galeria = await listarGaleria(ctx);
        const { error: err } = await ctx.supabase.from('gallery_items').insert({
          piece_id: pieza.id,
          antes_photo_id: antes.id,
          despues_photo_id: despues.id,
          // Copia resuelta: la web lee estos campos directo, sin joins.
          titulo: pieza.titulo,
          antes_url: antes.url,
          despues_url: despues.url,
          tag_servicio: textoONull(form.get('tag_servicio')),
          destacada_home: form.get('destacada_home') === 'on',
          orden: numeroONull(form.get('orden')) ?? galeria.length,
          created_by: usuario.id,
        });

        if (err) {
          error = err.message;
        } else {
          return Astro.redirect('/admin/galeria?ok=agregado');
        }
      }
    }
  }
}

const galeria = await listarGaleria(ctx);
const piezas = await listarPiezasConFotos(ctx);
const ok = Astro.url.searchParams.get('ok');

const jsonPiezas = JSON.stringify(
  piezas.map((p) => ({
    id: p.id,
    titulo: p.titulo,
    fotos: p.fotos.map((f) => ({ id: f.id, url: f.url, rol: f.rol })),
  })),
).replace(/</g, '\\u003c');

/** Texto de la etiqueta de cada foto, para los <option>. */
function etiquetaDe(foto: { rol: string }): string {
  if (foto.rol === 'antes') return 'Antes';
  if (foto.rol === 'despues') return 'Después';
  return 'General';
}
---

<AdminLayout
  titulo="Galería antes/después"
  subtitulo="Elegí una pieza y marcá qué foto es el antes y cuál el después. La web muestra hasta 3 pares."
>
  <script type="application/json" id="datos-piezas" set:html={jsonPiezas} />

  <div x-data="galeria()" x-cloak class="space-y-4">
    {
      error && (
        <p class="rounded border border-[#a03328] bg-[#f9e5e2] px-4 py-3 text-sm text-[#7d2c23]">
          {error}
        </p>
      )
    }

    {
      ok && (
        <p class="rounded border border-[#37603f] bg-[#e2efe3] px-4 py-3 text-sm text-[#2a4a30]">
          Par agregado a la galería.
        </p>
      )
    }

    <!-- ============ Pares actuales ============ -->
    {
      galeria.length === 0 ? (
        <div class="ui-panel">
          <div class="ui-vacio">
            <p class="ui-vacio-titulo">Todavía no hay pares</p>
            <p class="ui-vacio-texto">
              {piezas.length === 0
                ? 'Primero publicá una pieza con fotos en /admin/piezas. Después volvé acá a armar el par.'
                : 'Armá el primero con el formulario de abajo.'}
            </p>
          </div>
        </div>
      ) : (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {galeria.map((item) => (
            <li class="ui-panel overflow-hidden">
              <div class="grid grid-cols-2">
                <img
                  src={item.antes_url}
                  alt={`${item.titulo ?? 'Pieza'} antes`}
                  class="aspect-square w-full object-cover"
                  loading="lazy"
                />
                <img
                  src={item.despues_url}
                  alt={`${item.titulo ?? 'Pieza'} después`}
                  class="aspect-square w-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="p-3">
                <p class="ui-truncate text-sm font-medium text-ui-texto">
                  {item.titulo ?? 'Sin título'}
                </p>
                <p class="text-xs text-ui-texto-3">
                  {item.tag_servicio ?? 'Sin etiqueta'}
                </p>
                <div class="mt-3 flex items-center justify-between gap-2">
                  <form method="post">
                    <input type="hidden" name="_accion" value="destacar" />
                    <input type="hidden" name="id" value={item.id} />
                    <input
                      type="hidden"
                      name="valor"
                      value={item.destacada_home ? 'off' : 'on'}
                    />
                    <button type="submit" class="text-xs text-ui-acento underline underline-offset-4">
                      {item.destacada_home ? 'Quitar de la home' : 'Destacar en la home'}
                    </button>
                  </form>
                  <form method="post">
                    <input type="hidden" name="_accion" value="borrar" />
                    <input type="hidden" name="id" value={item.id} />
                    <button
                      type="submit"
                      class="text-xs text-[#a03328] underline underline-offset-4"
                      onclick="return confirm('¿Quitar este par de la galería?')"
                    >
                      Quitar
                    </button>
                  </form>
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    <!-- ============ Armar un par ============ -->
    <h2 class="pt-2 text-lg font-semibold text-ui-texto">Armar un par</h2>

    {
      piezas.length === 0 ? (
        <p class="rounded border border-dashed border-ui-borde-fuerte px-4 py-8 text-center text-sm text-ui-texto-2">
          No hay piezas con fotos todavía. Publicá una en
          <span class="font-medium text-ui-texto">/admin → Piezas</span> y volvé acá.
        </p>
      ) : (
        <form
          method="post"
          enctype="multipart/form-data"
          class="ui-panel max-w-3xl space-y-5 p-5"
        >
          <input type="hidden" name="_accion" value="agregar" />

          <!-- 1. Que pieza -->
          <div>
            <label class="ui-label" for="piece_id">1. ¿De qué pieza es el par?</label>
            <select
              class="ui-campo"
              id="piece_id"
              name="piece_id"
              x-model="pieceId"
              x-on:change="alCambiarPieza()"
            >
              <option value="">Elegí una pieza…</option>
              {piezas.map((p) => (
                <option value={p.id}>
                  {p.titulo} ({p.fotos.length} {p.fotos.length === 1 ? 'foto' : 'fotos'})
                </option>
              ))}
            </select>
            <p class="ui-ayuda" x-show="faltanFotos">
              Esta pieza tiene una sola foto. Subile al menos dos desde
              /admin → Piezas para armar un antes y un después distintos.
            </p>
          </div>

          <!-- 2. Que foto es cada una. Cada lado tiene su select con las
               fotos de la pieza y un boton de subida al costado: desde el
               celular se adjunta la foto ahi mismo, sin pasar por Piezas. -->
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <span class="ui-label">2. Foto "antes"</span>
              <div class="flex items-center gap-2">
                <select
                  class="ui-campo"
                  id="antes_photo_id"
                  name="antes_photo_id"
                  x-model="fotoAntes"
                  x-bind:disabled="!piezaActual || archivoAntes"
                >
                  <option value="">Sin elegir</option>
                  {
                    piezas.flatMap((pieza) =>
                      pieza.fotos.map((foto) => (
                        <option
                          value={foto.id}
                          data-pieza={pieza.id}
                          x-show="$el.dataset.pieza === pieceId"
                        >
                          {etiquetaDe(foto)} · {pieza.titulo}
                        </option>
                      )),
                    )
                  }
                </select>

                <button
                  type="button"
                  class="ui-btn ui-btn-icono shrink-0"
                  x-bind:class="archivoAntes ? 'ui-btn-acento' : 'ui-btn-neutro'"
                  x-on:click="$refs.inputAntes.click()"
                  x-bind:disabled="!piezaActual"
                  title="Subir una foto desde el dispositivo"
                  aria-label="Subir una foto desde el dispositivo para el antes"
                >
                  <Icon nombre="subir" clase="size-4" />
                </button>
              </div>

              <input
                class="sr-only"
                type="file"
                name="foto_antes_archivo"
                accept="image/jpeg,image/png,image/webp,image/gif"
                x-ref="inputAntes"
                x-on:change="elegirArchivo($event, 'antes')"
              />

              <div class="mt-2 flex items-center gap-2" x-show="archivoAntes" x-cloak>
                <img
                  x-bind:src="vistaPreviaAntes"
                  alt="Vista previa"
                  class="h-12 w-12 rounded border border-ui-borde object-cover"
                />
                <span class="truncate text-xs text-ui-texto-2" x-text="nombreAntes"></span>
                <button
                  type="button"
                  class="ml-auto text-xs text-[#a03328] underline underline-offset-4"
                  x-on:click="quitarArchivo('antes')"
                >
                  Quitar
                </button>
              </div>
            </div>

            <div>
              <span class="ui-label">3. Foto "después"</span>
              <div class="flex items-center gap-2">
                <select
                  class="ui-campo"
                  id="despues_photo_id"
                  name="despues_photo_id"
                  x-model="fotoDespues"
                  x-bind:disabled="!piezaActual || archivoDespues"
                >
                  <option value="">Sin elegir</option>
                  {
                    piezas.flatMap((pieza) =>
                      pieza.fotos.map((foto) => (
                        <option
                          value={foto.id}
                          data-pieza={pieza.id}
                          x-show="$el.dataset.pieza === pieceId"
                        >
                          {etiquetaDe(foto)} · {pieza.titulo}
                        </option>
                      )),
                    )
                  }
                </select>

                <button
                  type="button"
                  class="ui-btn ui-btn-icono shrink-0"
                  x-bind:class="archivoDespues ? 'ui-btn-acento' : 'ui-btn-neutro'"
                  x-on:click="$refs.inputDespues.click()"
                  x-bind:disabled="!piezaActual"
                  title="Subir una foto desde el dispositivo"
                  aria-label="Subir una foto desde el dispositivo para el despues"
                >
                  <Icon nombre="subir" clase="size-4" />
                </button>
              </div>

              <input
                class="sr-only"
                type="file"
                name="foto_despues_archivo"
                accept="image/jpeg,image/png,image/webp,image/gif"
                x-ref="inputDespues"
                x-on:change="elegirArchivo($event, 'despues')"
              />

              <div class="mt-2 flex items-center gap-2" x-show="archivoDespues" x-cloak>
                <img
                  x-bind:src="vistaPreviaDespues"
                  alt="Vista previa"
                  class="h-12 w-12 rounded border border-ui-borde object-cover"
                />
                <span class="truncate text-xs text-ui-texto-2" x-text="nombreDespues"></span>
                <button
                  type="button"
                  class="ml-auto text-xs text-[#a03328] underline underline-offset-4"
                  x-on:click="quitarArchivo('despues')"
                >
                  Quitar
                </button>
              </div>
            </div>
          </div>

          <!-- Vista previa -->
          <div
            class="overflow-hidden rounded border border-ui-borde"
            x-show="urlAntes && urlDespues"
            x-cloak
          >
            <div class="grid grid-cols-2">
              <img
                x-bind:src="urlAntes"
                alt="Antes"
                class="aspect-square w-full object-cover"
              />
              <img
                x-bind:src="urlDespues"
                alt="Después"
                class="aspect-square w-full object-cover"
              />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="ui-label" for="tag_servicio">Etiqueta (opcional)</label>
              <input
                class="ui-campo"
                id="tag_servicio"
                name="tag_servicio"
                placeholder="Ej: Lustre"
                x-model="tag"
              />
            </div>
            <div>
              <label class="ui-label" for="orden">Orden</label>
              <input
                class="ui-campo ui-num"
                id="orden"
                name="orden"
                type="number"
                min="0"
                x-model="orden"
              />
            </div>
          </div>

          <label class="flex items-center gap-2 text-sm text-ui-texto-2">
            <input type="checkbox" name="destacada_home" class="accent-[#96652a]" checked />
            Mostrar en la home
          </label>

          <button type="submit" class="ui-btn ui-btn-acento" :disabled="!puedeGuardar()">
            <Icon nombre="mas" clase="size-4" />
            Agregar a la galería
          </button>
        </form>
      )
    }
  </div>
</AdminLayout>

<script>
  import { Alpine, leerDatos } from '../../scripts/admin';

  interface Foto {
    id: string;
    url: string;
    rol: string;
  }

  interface Pieza {
    id: string;
    titulo: string;
    fotos: Foto[];
  }

  function galeriaEstado() {
    return {
      piezas: leerDatos<Pieza[]>('datos-piezas'),
      pieceId: '',
      fotoAntes: '',
      fotoDespues: '',
      tag: '',
      orden: '0',

      /** Fotos elegidas desde el dispositivo, por lado. */
      archivoAntes: null as File | null,
      archivoDespues: null as File | null,
      vistaPreviaAntes: '',
      vistaPreviaDespues: '',
      nombreAntes: '',
      nombreDespues: '',

      init(this: { orden: string; piezas: Pieza[] }) {
        this.orden = String(this.piezas.length);
      },

      etiquetaDe(foto: Foto): string {
        if (foto.rol === 'antes') return 'Antes';
        if (foto.rol === 'despues') return 'Después';
        return 'General';
      },

      piezaActual(this: { piezas: Pieza[]; pieceId: string }): Pieza | null {
        return this.piezas.find((p) => p.id === this.pieceId) ?? null;
      },

      urlAntes(this: {
        piezaActual: () => Pieza | null;
        fotoAntes: string;
        vistaPreviaAntes: string;
      }): string {
        if (this.vistaPreviaAntes) return this.vistaPreviaAntes;
        return this.piezaActual()?.fotos.find((f) => f.id === this.fotoAntes)?.url ?? '';
      },

      urlDespues(this: {
        piezaActual: () => Pieza | null;
        fotoDespues: string;
        vistaPreviaDespues: string;
      }): string {
        if (this.vistaPreviaDespues) return this.vistaPreviaDespues;
        return this.piezaActual()?.fotos.find((f) => f.id === this.fotoDespues)?.url ?? '';
      },

      /** Al cambiar de pieza se limpian las dos fotos. */
      alCambiarPieza(this: {
        fotoAntes: string;
        fotoDespues: string;
        limpiarArchivo: (lado: 'antes' | 'despues') => void;
      }) {
        this.fotoAntes = '';
        this.fotoDespues = '';
        this.limpiarArchivo('antes');
        this.limpiarArchivo('despues');
      },

      /** Foto nueva desde el dispositivo. */
      elegirArchivo(evento: Event, lado: 'antes' | 'despues') {
        const input = evento.target as HTMLInputElement;
        const archivo = input.files?.[0];
        if (!archivo) return;

        this.limpiarArchivo(lado);

        if (lado === 'antes') {
          this.archivoAntes = archivo;
          this.vistaPreviaAntes = URL.createObjectURL(archivo);
          this.nombreAntes = archivo.name;
          this.fotoAntes = '';
        } else {
          this.archivoDespues = archivo;
          this.vistaPreviaDespues = URL.createObjectURL(archivo);
          this.nombreDespues = archivo.name;
          this.fotoDespues = '';
        }
      },

      limpiarArchivo(lado: 'antes' | 'despues') {
        if (lado === 'antes') {
          if (this.vistaPreviaAntes) URL.revokeObjectURL(this.vistaPreviaAntes);
          this.archivoAntes = null;
          this.vistaPreviaAntes = '';
          this.nombreAntes = '';
        } else {
          if (this.vistaPreviaDespues) URL.revokeObjectURL(this.vistaPreviaDespues);
          this.archivoDespues = null;
          this.vistaPreviaDespues = '';
          this.nombreDespues = '';
        }
      },

      /** La pieza elegida tiene menos de dos fotos: no alcanza para un par. */
      faltanFotos(this: {
        piezaActual: () => Pieza | null;
        archivoAntes: File | null;
        archivoDespues: File | null;
      }): boolean {
        if (this.archivoAntes || this.archivoDespues) return false;
        const fotos = this.piezaActual()?.fotos.length ?? 0;
        return fotos > 0 && fotos < 2;
      },

      puedeGuardar(this: {
        fotoAntes: string;
        fotoDespues: string;
        archivoAntes: File | null;
        archivoDespues: File | null;
      }): boolean {
        const antes = Boolean(this.archivoAntes || this.fotoAntes);
        const despues = Boolean(this.archivoDespues || this.fotoDespues);
        return antes && despues;
      },
    };
  }

  Alpine.data('galeria', galeriaEstado);
</script>