---
/**
 * Papelera de cotizaciones.
 *
 * Lo que se elimina desde el detalle de un pedido no se borra: se copia acá
 * y se purga solo pasado el plazo. Sirve para recuperar un borrado sin
 * querer, que es el único motivo real por el que se borra algo.
 *
 * El purgado de lo vencido corre en cada visita a esta página. No es un job
 * de base porque Storage tiene un trigger que impide borrar desde SQL: un
 * job podría limpiar la fila y dejaría las fotos huérfanas en el bucket.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  adminContext,
  borrarDePapelera,
  DIAS_EN_PAPELERA,
  listarPapelera,
  restaurarDePapelera,
  type PapeleraItem,
} from '../../lib/admin';

const ctx = adminContext(Astro.request, Astro.cookies);

const errores: string[] = [];
let papelera: PapeleraItem[] = [];

try {
  papelera = await listarPapelera(ctx);
} catch (e) {
  errores.push(e instanceof Error ? e.message : 'No se pudo leer la papelera.');
}

let error = '';
const ok = Astro.url.searchParams.get('ok');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = String(form.get('_accion') ?? '');
  const id = String(form.get('id') ?? '');

  try {
    if (accion === 'restaurar') await restaurarDePapelera(ctx, id);
    else if (accion === 'borrar') await borrarDePapelera(ctx, id);
    return Astro.redirect(
      `/admin/papelera?ok=${accion === 'restaurar' ? 'restaurada' : 'borrada'}`,
    );
  } catch (e) {
    error = e instanceof Error ? e.message : 'No se pudo hacer eso.';
  }
}

/** "vence en 2 días" / "se borra hoy" / "venció" */
function cuandoVence(seBorraEl: string): { texto: string; vencido: boolean } {
  const ms = new Date(seBorraEl).getTime() - Date.now();
  const dias = Math.ceil(ms / 86_400_000);

  if (ms <= 0) return { texto: 'Ya se purgó', vencido: true };
  if (dias <= 1) return { texto: 'Se borra en menos de un día', vencido: false };
  return { texto: `Se borra en ${dias} días`, vencido: false };
}
---

<AdminLayout
  titulo="Papelera"
  subtitulo={`Las cotizaciones que descartaste. Se borran solas ${DIAS_EN_PAPELERA} días después de pasar por acá.`}
>
  <div class="mt-6 max-w-3xl space-y-4">
    {
      errores.map((mensaje) => (
        <p class="rounded border border-[#a03328] bg-[#a03328]/10 px-4 py-3 text-sm text-[#7a2626]">
          {mensaje}
        </p>
      ))
    }

    {
      error && (
        <p class="rounded border border-[#a03328] bg-[#a03328]/10 px-4 py-3 text-sm text-[#7a2626]">
          {error}
        </p>
      )
    }

    {
      ok === 'restaurada' && (
        <p class="rounded border border-[#4f6b46] bg-[#4f6b46]/10 px-4 py-3 text-sm text-[#33472e]">
          Volvió a la lista de cotizaciones.
        </p>
      )
    }

    {
      ok === 'borrada' && (
        <p class="rounded border border-[#4f6b46] bg-[#4f6b46]/10 px-4 py-3 text-sm text-[#33472e]">
          Borrada para siempre.
        </p>
      )
    }

    {
      papelera.length === 0 ? (
        <p class="rounded border border-dashed border-ui-borde px-4 py-8 text-center text-sm text-ui-texto-2">
          No hay nada en la papelera.
        </p>
      ) : (
        <ul class="space-y-3">
          {papelera.map((item) => {
            const { texto, vencido } = cuandoVence(item.se_borra_el);

            return (
              <li class="ui-panel p-4">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <div>
                    <p class="ui-truncate text-sm font-medium text-ui-texto">
                      {item.nombre}
                    </p>
                    <p class="text-xs text-ui-texto-3">
                      {item.telefono}
                      {item.tipo_mueble ? ` · ${item.tipo_mueble}` : ''}
                      {item.comuna ? ` · ${item.comuna}` : ''}
                    </p>
                  </div>

                  <p
                    class:list={[
                      'text-xs',
                      vencido ? 'text-ui-peligro' : 'text-ui-texto-3',
                    ]}
                  >
                    {texto}
                  </p>
                </div>

                {item.descripcion && (
                  <p class="mt-2 line-clamp-2 text-sm text-ui-texto-2">
                    {item.descripcion}
                  </p>
                )}

                <p class="mt-2 text-xs text-ui-texto-3">
                  {item.fotos.length > 0
                    ? `Traía ${item.fotos.length} foto${item.fotos.length === 1 ? '' : 's'}. Se borran con el pedido.`
                    : 'Sin fotos.'}
                </p>

                <div class="mt-3 flex flex-wrap gap-2">
                  <form method="post">
                    <input type="hidden" name="_accion" value="restaurar" />
                    <input type="hidden" name="id" value={item.id} />
                    <button type="submit" class="ui-btn ui-btn-acento ui-btn-sm">
                      Devolver a la lista
                    </button>
                  </form>

                  <form method="post">
                    <input type="hidden" name="_accion" value="borrar" />
                    <input type="hidden" name="id" value={item.id} />
                    <button type="submit" class="ui-btn ui-btn-neutro ui-btn-sm">
                      Borrar ahora
                    </button>
                  </form>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }

    <p class="pt-2 text-xs text-ui-texto-3">
      "Borrar ahora" no tiene vuelta atrás: saca el pedido y sus fotos de una.
      Para algo reversible, mejor esperes a que se purgue solo.
    </p>
  </div>
</AdminLayout>