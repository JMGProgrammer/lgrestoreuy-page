---
/**
 * Login del panel.
 *
 * Página propia, con su propio <html>: el AdminLayout pide sesión y trae la
 * navegación, que acá no tienen sentido. Comparte sí el sistema visual del
 * panel (admin.css) y el fondo de ondas, para que entrar se sienta como
 * entrar al panel y no a otro sitio.
 */
import '../../styles/global.css';
import '../../styles/admin.css';
import { getSupabaseConSesion } from '../../lib/supabase/server';

const hayEnv =
  !!import.meta.env.PUBLIC_SUPABASE_URL && !!import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// Si ya hay sesión, no tiene sentido mostrar el login
if (hayEnv) {
  const supabase = getSupabaseConSesion(Astro.request, Astro.cookies);
  const {
    data: { user },
  } = await supabase.auth.getUser();

  if (user) return Astro.redirect('/admin');
}

const mensaje = Astro.url.searchParams.get('next');
const error = Astro.url.searchParams.get('error');

/** Un texto por causa. Decir "algo salió mal" obliga a adivinar. */
const ERRORES: Record<string, string> = {
  credenciales: 'Correo o contraseña incorrectos.',
  'no-confirmado':
    'Ese usuario existe pero el correo no está confirmado. Hay que confirmarlo en Supabase → Authentication → Users.',
  generico: 'No pudimos iniciar sesión. Probá de nuevo.',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Entrar · Panel</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Inter:wght@400;500;600&display=swap"
    />
  </head>

  <body class="admin">
    <div class="ui-olas" aria-hidden="true"></div>

    <main class="flex min-h-svh items-center justify-center px-4 py-10">
      <div class="w-full max-w-sm">
        <div class="ui-panel p-6 sm:p-7">
          <div class="text-center">
            <p class="font-display text-xl font-semibold text-ui-texto">
              L&amp;G Restore
            </p>
            <p class="mt-1 text-sm text-ui-texto-2">Panel de administración</p>
          </div>

          <div class="rule-dorada my-6"></div>

          {
            !hayEnv && (
              <p class="ui-aviso ui-aviso-error mb-5 text-sm">
                <span>
                  Faltan las variables de Supabase en el <code>.env</code>.
                  Configuralas y recargá la página.
                </span>
              </p>
            )
          }

          {
            error && (
              <p class="ui-aviso ui-aviso-error mb-5 text-sm" role="alert">
                <span>{ERRORES[error] ?? ERRORES.generico}</span>
              </p>
            )
          }

          <form method="post" action="/api/admin/login" class="space-y-4">
            {
              mensaje && <input type="hidden" name="next" value={mensaje} />
            }

            <div>
              <label class="ui-label" for="email">Correo</label>
              <input
                class="ui-campo"
                id="email"
                name="email"
                type="email"
                required
                autofocus
                autocomplete="username"
                placeholder="taller@ejemplo.com"
              />
            </div>

            <div>
              <label class="ui-label" for="password">Contraseña</label>
              <input
                class="ui-campo"
                id="password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
              />
            </div>

            <button
              type="submit"
              class="ui-btn ui-btn-acento w-full justify-center"
              disabled={!hayEnv}
            >
              Entrar
            </button>
          </form>
        </div>

        <p class="mt-5 text-center text-xs text-ui-texto-3">
          <a href="/" class="ui-link">Volver a la web</a>
        </p>
      </div>
    </main>
  </body>
</html>