---
import { getSupabaseConSesion } from '../../lib/supabase/server';

const hayEnv =
  !!import.meta.env.PUBLIC_SUPABASE_URL && !!import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// Si ya hay sesión, no tiene sentido mostrar el login
if (hayEnv) {
  const supabase = getSupabaseConSesion(Astro.request, Astro.cookies);
  const {
    data: { user },
  } = await supabase.auth.getUser();

  if (user) return Astro.redirect('/admin');
}

const mensaje = Astro.url.searchParams.get('next');
const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entrar al panel</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap"
    />
  </head>

  <body class="flex min-h-screen items-center justify-center bg-lino px-4">
    <main class="w-full max-w-sm">
      <div class="rounded border border-linea bg-papel p-8 sombra-vintage">
        <p class="rotulo text-center">L&amp;G Restore</p>
        <h1 class="mt-2 text-center font-display text-2xl text-tinta">Panel</h1>

        {
          !hayEnv && (
            <p class="mt-6 rounded border border-[#9a6b2f] bg-[#9a6b2f]/10 px-3 py-2 text-xs text-caoba">
              Faltan las variables de Supabase en el .env. Configuralas y recargá
              la página.
            </p>
          )
        }

        {
          error && (
            <p class="mt-6 rounded border border-[#9a2f2f] bg-[#9a2f2f]/10 px-3 py-2 text-xs text-[#7a2626]">
              {error === 'credenciales'
                ? 'Correo o contraseña incorrectos.'
                : 'No pudimos iniciar sesión. Probá de nuevo.'}
            </p>
          )
        }

        <form method="post" action="/api/admin/login" class="mt-6 space-y-4">
          {
            mensaje && <input type="hidden" name="next" value={mensaje} />
          }

          <div>
            <label class="campo-label" for="email">Correo</label>
            <input
              class="campo"
              id="email"
              name="email"
              type="email"
              required
              autocomplete="username"
            />
          </div>

          <div>
            <label class="campo-label" for="password">Contraseña</label>
            <input
              class="campo"
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
            />
          </div>

          <button type="submit" class="btn-principal w-full" disabled={!hayEnv}>
            Entrar
          </button>
        </form>
      </div>

      <p class="mt-6 text-center text-xs text-tinta-tenue">
        <a href="/" class="underline decoration-latón underline-offset-4">
          Volver a la web
        </a>
      </p>
    </main>
  </body>
</html>