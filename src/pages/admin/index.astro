---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/admin/Icon.astro';
import { adminContext, listarCotizaciones, resumen } from '../../lib/admin';
import { formatUYU } from '../../lib/whatsapp';

const ctx = adminContext(Astro.request, Astro.cookies);
const [datos, cotizaciones] = await Promise.all([
  resumen(ctx),
  listarCotizaciones(ctx, 5),
]);

// Próximos pasos como acción visible: cada fila tiene icono y un botón
// real que lleva a donde se hace el paso. Sin links subrayados escondidos
// entre texto, que son la única cosa del panel que no se ve.
const pasos = [
  {
    icono: 'whatsapp' as const,
    texto:
      'Cargar tus datos (WhatsApp, dirección, horarios) y activar el botón de consulta.',
    href: '/admin/contenido',
    boton: 'Ir a Contenido',
  },
  {
    icono: 'mas' as const,
    texto: 'Revisar los servicios y completar los rangos de precio.',
    href: '/admin/servicios',
    boton: 'Ir a Servicios',
  },
  {
    icono: 'imagen' as const,
    texto: 'Publicar piezas con fotos antes y después.',
    href: '/admin/piezas',
    boton: 'Ir a Piezas',
  },
];

// Cada tarjeta lleva a la sección donde ese número se trabaja. Sin destino,
// el hover sería un efecto mentiroso.
const tarjetas = [
  {
    etiqueta: 'Piezas disponibles',
    valor: String(datos.piezasDisponibles),
    href: '/admin/piezas',
  },
  {
    etiqueta: 'En proceso',
    valor: String(datos.piezasEnProceso),
    href: '/admin/piezas',
  },
  {
    etiqueta: 'Valor en stock',
    valor: formatUYU(datos.valorStock) ?? '$0',
    href: '/admin/piezas',
  },
  {
    etiqueta: 'Cotizaciones nuevas',
    valor: String(datos.cotizacionesNuevas),
    href: '/admin/cotizaciones',
  },
];
---

<AdminLayout titulo="Resumen">
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      tarjetas.map((tarjeta) => (
        <a
          href={tarjeta.href}
          class="ui-tarjeta textura-papel rounded border border-linea p-5"
        >
          <p class="ui-tarjeta-valor font-display text-3xl text-tinta transition-colors duration-[180ms]">
            {tarjeta.valor}
          </p>
          <p class="rotulo mt-1">{tarjeta.etiqueta}</p>
        </a>
      ))
    }
  </div>

  {
    datos.serviciosSinPrecio > 0 && (
      <p class="mt-6 rounded border border-[#9a6b2f] bg-[#9a6b2f]/10 px-4 py-3 text-sm text-caoba">
        {datos.serviciosSinPrecio}{' '}
        {datos.serviciosSinPrecio === 1 ? 'servicio activo no tiene' : 'servicios activos no tienen'}{' '}
        rango de precio. La web los muestra como "A consultar".
      </p>
    )
  }

  <section class="mt-10">
    <div class="flex items-baseline justify-between">
      <h2 class="text-lg text-tinta">Últimas cotizaciones</h2>
      <a
        href="/admin/cotizaciones"
        class="ui-btn ui-btn-fantasma ui-btn-sm"
      >
        Ver todas
        <Icon nombre="flecha" clase="size-3.5" />
      </a>
    </div>

    {
      cotizaciones.length === 0 ? (
        <p class="mt-4 rounded border border-dashed border-linea px-4 py-8 text-center text-sm text-tinta-suave">
          Todavía no llegaron cotizaciones. Aparecen acá apenas alguien use el
          formulario de la web.
        </p>
      ) : (
        <ul class="mt-4 divide-y divide-linea rounded border border-linea bg-papel">
          {cotizaciones.map((c) => (
            <li class="flex flex-wrap items-baseline justify-between gap-2 px-4 py-3">
              <div>
                <p class="text-sm text-tinta">{c.nombre}</p>
                <p class="text-xs text-tinta-tenue">
                  {c.telefono}
                  {c.tipo_mueble ? ` · ${c.tipo_mueble}` : ''}
                  {c.comuna ? ` · ${c.comuna}` : ''}
                </p>
              </div>
              <div class="flex items-center gap-3">
                <span class="rotulo">{c.estado}</span>
                <a
                  href={`/admin/cotizaciones/${c.id}`}
                  class="ui-btn ui-btn-neutro ui-btn-sm"
                >
                  Abrir
                  <Icon nombre="flecha" clase="size-3.5" />
                </a>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="mt-10">
    <h2 class="text-lg text-tinta">Próximos pasos</h2>
    <ul class="mt-4 space-y-2">
      {
        pasos.map((paso) => (
          <li class="flex flex-wrap items-center justify-between gap-2 rounded border border-linea bg-papel px-4 py-3">
            <span class="flex min-w-0 items-center gap-2.5 text-sm text-tinta-suave">
              <span class="grid size-7 shrink-0 place-items-center rounded-full bg-[#9a6b2f]/15 text-caoba">
                <Icon nombre={paso.icono} clase="size-4" />
              </span>
              <span class="min-w-0">{paso.texto}</span>
            </span>
            <a href={paso.href} class="ui-btn ui-btn-neutro ui-btn-sm ml-auto">
              {paso.boton}
              <Icon nombre="flecha" clase="size-3.5" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</AdminLayout>