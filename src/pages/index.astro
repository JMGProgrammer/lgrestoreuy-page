---
import BaseLayout from '../layouts/BaseLayout.astro';
import Imagen from '../components/Imagen.astro';
import Comparador from '../components/Comparador.astro';
import {
  getServices,
  getPieces,
  getGalleryHighlights,
  MODO_DEMO,
} from '../lib/content';
import { formatPriceRange, formatUYU } from '../lib/whatsapp';

const [services, pieces, gallery] = await Promise.all([
  getServices(),
  getPieces({ soloDestacadas: true, limit: 4 }),
  getGalleryHighlights(6),
]);

/**
 * Pares antes/después para el comparador. Sin trabajos cargados queda vacío y
 * el comparador dibuja su propio estado vacío: dos tonos neutros, oscuro y
 * claro. Nada de ilustraciones de relleno.
 */
const comparables = gallery.map((item) => ({
  id: item.id,
  titulo: item.titulo ?? 'Trabajo del taller',
  antes: item.antes_url,
  despues: item.despues_url,
  etiqueta: item.tag_servicio,
}));

const precioPieza = (p: (typeof pieces)[number]) =>
  formatUYU(p.precio) ?? 'A consultar';
---

<BaseLayout>
  {
    MODO_DEMO && (
      <div class="border-b border-latón/40 bg-latón-tenue/50 px-4 py-2 text-center text-xs text-caoba">
        Modo demostración: faltan las claves de Supabase en <code>.env</code>.
        Se muestran datos de ejemplo.
      </div>
    )
  }

  <!-- ================= HERO ================= -->
  <section class="border-b border-linea bg-papel">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 lg:grid-cols-[1.1fr_1fr] lg:py-24">
      <div class="self-center">
        <p class="rotulo">Restauración de muebles y antigüedades</p>
        <h1
          class="mt-4 text-4xl leading-[1.1] text-tinta sm:text-5xl lg:text-6xl"
        >
          Muebles con historia,<br />
          <span class="text-latón">restaurados como merecen.</span>
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-tinta-suave">
          Reparamos estructura, aplicamos lustre y pintura, y recuperamos piezas
          de época. Contanos qué pieza tenés y te pasamos un presupuesto sin
          compromiso.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/cotizar" class="btn-principal">Pedir cotización</a>
          <a href="/piezas" class="btn-secundario">Ver piezas en venta</a>
        </div>

        <dl class="mt-12 grid max-w-md grid-cols-3 gap-6 border-t border-linea pt-6">
          {
            [
              { k: 'Evaluación', v: 'Evaluación en el taller' },
              { k: 'Retiro', v: 'Retiro a domicilio' },
              { k: 'Garantía', v: 'Garantía por escrito' },
            ].map((item) => (
              <div>
                <dt class="rotulo mb-1">{item.k}</dt>
                <dd class="text-sm leading-snug text-tinta-suave">
                  {item.v}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Antes / después con línea movible y navegación entre trabajos -->
      <Comparador pares={comparables} proporcion="3 / 4" />
    </div>
  </section>

  <!-- ================= SERVICIOS ================= -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="rotulo">Qué hacemos</p>
        <h2 class="mt-2 text-3xl text-tinta">Servicios</h2>
      </div>
      <a
        href="/servicios"
        class="text-sm text-tinta-suave underline decoration-latón underline-offset-4 hover:text-tinta"
      >
        Ver todos
      </a>
    </div>

    <div class="rule-dorada my-6"></div>

    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.slice(0, 6).map((servicio) => (
          <li class="textura-papel rounded border border-linea p-6">
            <h3 class="text-xl text-tinta">{servicio.nombre}</h3>
            {servicio.descripcion && (
              <p class="mt-3 text-sm leading-relaxed text-tinta-suave">
                {servicio.descripcion}
              </p>
            )}
            <p class="mt-4 font-display text-lg text-latón">
              {formatPriceRange(servicio.precio_min, servicio.precio_max)}
            </p>
          </li>
        ))
      }

      {
        services.length === 0 && (
          <li class="col-span-full rounded border border-dashed border-linea p-6 text-sm text-tinta-suave">
            Estamos preparando la lista de servicios.
          </li>
        )
      }
    </ul>
  </section>

  <!-- ================= PIEZAS ================= -->
  {
    pieces.length > 0 && (
      <section class="border-y border-linea bg-papel">
        <div class="mx-auto max-w-6xl px-4 py-16">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="rotulo">Stock del taller</p>
              <h2 class="mt-2 text-3xl text-tinta">Piezas en venta</h2>
            </div>
            <a
              href="/piezas"
              class="text-sm text-tinta-suave underline decoration-latón underline-offset-4 hover:text-tinta"
            >
              Ver todas
            </a>
          </div>

          <div class="rule-dorada my-6"></div>

          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {pieces.map((pieza) => {
              const foto = pieza.fotos[0];
              return (
                <li>
                  <a
                    href={`/piezas/${pieza.slug}`}
                    class="group block overflow-hidden rounded border border-linea bg-lino transition-colors hover:border-latón"
                  >
                    {foto ? (
                      <Imagen
                        src={foto.url}
                        alt={pieza.titulo}
                        ratio="4 / 5"
                        class="transition-transform duration-500 group-hover:scale-[1.04]"
                      />
                    ) : (
                      <div class="flex aspect-[4/5] items-center justify-center bg-papel-oscuro text-xs text-tinta-tenue">
                        Sin foto
                      </div>
                    )}
                    <div class="p-4">
                      <h3 class="font-display text-lg text-tinta">
                        {pieza.titulo}
                      </h3>
                      <p class="mt-1 text-sm text-latón">
                        {precioPieza(pieza)}
                      </p>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ================= CTA ================= -->
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div
      class="rounded border border-linea bg-nogal px-6 py-12 text-center sombra-vintage sm:px-12"
    >
      <p class="rotulo text-latón-tenue">¿Empezamos?</p>
      <h2 class="mx-auto mt-3 max-w-xl text-3xl text-papel sm:text-4xl">
        Contanos qué pieza tenés y te cotizamos
      </h2>
      <p class="mx-auto mt-4 max-w-md text-papel-oscuro">
        Fotos, medidas y una idea de qué querés: con eso alcanza para armar un
        presupuesto realista.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/cotizar"
          class="inline-flex items-center justify-center rounded bg-papel px-6 py-3 font-medium text-nogal transition-colors hover:bg-lino"
        >
          Cotizar ahora
        </a>
        <a
          href="/contacto"
          class="inline-flex items-center justify-center rounded border border-latón px-6 py-3 font-medium text-papel transition-colors hover:bg-caoba"
        >
          Escribirnos
        </a>
      </div>
    </div>
  </section>
</BaseLayout>