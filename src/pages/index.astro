---
import BaseLayout from '../layouts/BaseLayout.astro';
import Comparador from '../components/Comparador.astro';
import FondoPortada from '../components/FondoPortada.astro';
import CarruselPiezas from '../components/CarruselPiezas.astro';
import TarjetaPieza from '../components/TarjetaPieza.astro';
import TarjetaServicio from '../components/TarjetaServicio.astro';
import {
  getServices,
  getPieces,
  getGalleryHighlights,
  getSiteSettings,
  MODO_DEMO,
} from '../lib/content';

const [services, pieces, gallery, settings, orbitar] = await Promise.all([
  getServices(),
  getPieces({ soloDestacadas: true, limit: 4 }),
  getGalleryHighlights(6),
  getSiteSettings(),
  getPieces({ limit: 8 }),
]);

// Si la base todavía no tiene las columnas de la 0004, la web sigue
// entrando: salen undefined y el fondo cae a la textura de CSS.
const portadaUrl = settings.portada_url ?? null;
/**
 * Pares antes/después para el comparador. Sin trabajos cargados queda vacío y
 * el comparador dibuja su propio estado vacío: dos tonos neutros, oscuro y
 * claro. Nada de ilustraciones de relleno.
 */
const comparables = gallery.map((item) => ({
  id: item.id,
  titulo: item.titulo ?? 'Trabajo del taller',
  antes: item.antes_url,
  despues: item.despues_url,
  etiqueta: item.tag_servicio,
}));

---

<BaseLayout>
  {
    MODO_DEMO && (
      <div class="border-b border-latón/40 bg-latón-tenue/50 px-4 py-2 text-center text-xs text-caoba">
        Modo demostración: faltan las claves de Supabase en <code>.env</code>.
        Se muestran datos de ejemplo.
      </div>
    )
  }

  <!-- ================= HERO ================= -->
  <section class="hero-centro relative overflow-hidden border-b border-linea bg-papel">
    <FondoPortada url={portadaUrl} />

    {/*
      Texto centrado y debajo el carrusel 3D de piezas: cards
      horizontales con perspectiva que giran en sentido horario.
    */}
    <div
      class="relative z-10 mx-auto max-w-6xl px-4 py-14 sm:py-20 lg:py-24"
    >
      <div class="hero-nucleo relative mx-auto max-w-2xl text-center">
        <p class="rotulo">Restauración de muebles y antigüedades</p>
        <h1
          class="mt-3 text-4xl leading-[1.1] text-tinta sm:text-5xl lg:text-6xl"
        >
          Muebles con historia,<br />
          <span class="text-latón">restaurados como merecen.</span>
        </h1>
        <p class="mx-auto mt-5 max-w-lg text-lg leading-relaxed text-tinta-suave">
          Reparamos estructura, aplicamos lustre y pintura, y recuperamos piezas
          de época. Contanos qué pieza tenés y te pasamos un presupuesto sin
          compromiso.
        </p>

        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href="/cotizar" class="btn-principal">
            Pedir cotización
            <svg
              class="btn-flecha"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h13M12 5l7 7-7 7"></path>
            </svg>
          </a>
          <a href="/piezas" class="btn-secundario">Ver piezas en venta</a>
        </div>

        <dl
          class="mx-auto mt-10 grid max-w-md grid-cols-3 gap-6 border-t border-linea pt-6"
        >
          {
            [
              { k: 'Evaluación', v: 'Evaluación en el taller' },
              { k: 'Retiro', v: 'Retiro a domicilio' },
              { k: 'Garantía', v: 'Garantía por escrito' },
            ].map((item) => (
              <div>
                <dt class="rotulo mb-1">{item.k}</dt>
                <dd class="text-sm leading-snug text-tinta-suave">
                  {item.v}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    {/*
      El carrusel se mete debajo del texto: sube con margen negativo y pasa
      por detrás del bloque (que va por encima), así las cards quedan a la
      altura de las garantías en vez de perdidas abajo del todo.
    */}
    <div class="tira-carrusel relative pb-14 sm:pb-20">
      <CarruselPiezas piezas={orbitar} />
    </div>
  </section>

  <!-- ================= TRABAJOS ================= -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="mx-auto max-w-2xl text-center">
      <p class="rotulo">Trabajos del taller</p>
      <h2 class="mt-2 text-3xl text-tinta">Antes / después</h2>
      <p class="mt-3 leading-relaxed text-tinta-suave">
        Arrastrá la línea para ver cómo entra cada pieza y cómo sale
        restaurada.
      </p>
    </div>

    <div class="adorno" aria-hidden="true"><span></span></div>

    <div class="mx-auto max-w-3xl">
      <Comparador pares={comparables} proporcion="4 / 3" />
    </div>
  </section>

  <!-- ================= PIEZAS ================= -->
  {
    pieces.length > 0 && (
      <section class="border-y border-linea bg-papel">
        <div class="mx-auto max-w-6xl px-4 py-16">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="rotulo">Stock del taller</p>
              <h2 class="mt-2 text-3xl text-tinta">Piezas en venta</h2>
            </div>
            <a
              href="/piezas"
              class="text-sm text-tinta-suave underline decoration-latón underline-offset-4 hover:text-tinta"
            >
              Ver todas
            </a>
          </div>

          <div class="rule-dorada my-6"></div>

          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {pieces.map((pieza) => (
              <li>
                <TarjetaPieza pieza={pieza} whatsapp={settings.whatsapp} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ================= SERVICIOS ================= -->
  <section class="seccion-taller">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="rotulo">Qué hacemos · {services.length > 0 && `${services.length} oficios`}</p>
          <h2 class="mt-2 text-3xl text-tinta">Servicios</h2>
          <p class="mt-3 max-w-lg leading-relaxed text-tinta-suave">
            Tocá un oficio y cotizalo directo: el formulario ya viene con ese
            servicio elegido.
          </p>
        </div>
        <a
          href="/servicios"
          class="text-sm text-tinta-suave underline decoration-latón underline-offset-4 hover:text-tinta"
        >
          Ver todos
        </a>
      </div>

      <div class="adorno" aria-hidden="true"><span></span></div>

      <ul class="rejilla-oficios grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.slice(0, 6).map((servicio, i) => (
            <li>
              <TarjetaServicio servicio={servicio} indice={i} />
            </li>
          ))
        }

        {
          services.length === 0 && (
            <li class="col-span-full rounded border border-dashed border-linea p-6 text-sm text-tinta-suave">
              Estamos preparando la lista de servicios.
            </li>
          )
        }
      </ul>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div
      class="rounded border border-linea bg-nogal px-6 py-12 text-center sombra-vintage sm:px-12"
    >
      <p class="rotulo rotulo-latón">¿Empezamos?</p>
      <h2 class="mx-auto mt-3 max-w-xl text-3xl text-papel sm:text-4xl">
        Contanos qué pieza tenés y te cotizamos
      </h2>
      <p class="mx-auto mt-4 max-w-md text-papel-oscuro">
        Fotos, medidas y una idea de qué querés: con eso alcanza para armar un
        presupuesto realista.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/cotizar"
          class="inline-flex items-center justify-center rounded bg-papel px-6 py-3 font-medium text-nogal transition-colors hover:bg-lino"
        >
          Cotizar ahora
        </a>
        <a
          href="/contacto"
          class="inline-flex items-center justify-center rounded border border-latón px-6 py-3 font-medium text-papel transition-colors hover:bg-caoba"
        >
          Escribirnos
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /*
    Franja de taller: rompe el plano del fondo con papel y una trama de
    marquetería apenas insinuada. Todo dibujado con CSS: nada de fotos
    de relleno.
  */
  .seccion-taller {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--color-linea);
    background-color: var(--color-papel);
    background-image: repeating-linear-gradient(
      -45deg,
      rgb(168 118 62 / 5%) 0px,
      rgb(168 118 62 / 5%) 1px,
      transparent 1px,
      transparent 9px
    );
  }

  /* Filete con rombo al centro, como las incrustaciones */
  .adorno {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block: 1.5rem 2rem;
  }

  .adorno::before,
  .adorno::after {
    content: '';
    height: 1px;
    flex: 1;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-latón) 30%,
      var(--color-latón) 70%,
      transparent
    );
  }

  .adorno span {
    width: 0.55rem;
    height: 0.55rem;
    flex: 0 0 auto;
    transform: rotate(45deg);
    border: 1.5px solid var(--color-latón);
    background: var(--color-papel);
  }

  .rejilla-oficios > li {
    display: flex;
    min-width: 0;
  }

  .rejilla-oficios .tarjeta-servicio {
    flex: 1;
  }

  /* La tira sube y se mete debajo del texto (que va por encima): las
     cards quedan a la altura de las garantías. */
  .tira-carrusel {
    z-index: 0;
    margin-top: clamp(-10rem, -16vw, -5rem);
  }

  /* Núcleo legible sobre las cards que pasan por detrás */
  .hero-nucleo {
    background: radial-gradient(
      closest-side,
      rgb(251 247 239 / 94%) 55%,
      rgb(251 247 239 / 72%) 78%,
      transparent 100%
    );
  }


  @media (prefers-reduced-motion: reduce) {
    .seccion-taller {
      background-image: none;
    }

  }
</style>