---
/**
 * Botón flotante de WhatsApp. El href ya trae el mensaje precargado, así que
 * el cliente solo toca enviar. Se oculta si el taller no cargó el número.
 */
interface Props {
  href: string;
  label?: string;
}

const { href, label = 'Consultar por WhatsApp' } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group fixed right-4 bottom-4 z-40 flex items-center gap-2 rounded-full bg-[#1f7a4d] px-4 py-3 text-white sombra-vintage transition-transform hover:scale-[1.03] sm:right-6 sm:bottom-6"
  aria-label={label}
>
  <svg
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.9 9.9 0 0 0 4.74 1.2h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.05 2Zm0 18.12h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.1.81.83-3.02-.2-.31a8.19 8.19 0 0 1-1.26-4.37c0-4.54 3.7-8.23 8.23-8.23a8.16 8.16 0 0 1 5.8 2.4 8.16 8.16 0 0 1 2.4 5.82c0 4.54-3.7 8.23-8.21 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06a6.7 6.7 0 0 1-1.98-1.22 7.4 7.4 0 0 1-1.37-1.7c-.14-.25-.02-.38.1-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.09-.17.04-.31-.02-.43-.06-.12-.55-1.34-.76-1.83-.2-.48-.4-.41-.56-.42h-.47c-.16 0-.43.06-.65.31-.22.24-.86.84-.86 2.05s.88 2.38 1 2.55c.13.16 1.73 2.64 4.2 3.7.59.26 1.05.41 1.4.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.28Z"
    ></path>
  </svg>

  <span
    class="hidden text-sm font-medium sm:inline transition-opacity group-hover:opacity-90"
  >
    {label}
  </span>
</a>