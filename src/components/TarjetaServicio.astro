---
/**
 * Tarjeta de servicio para la home.
 *
 * Toda la tarjeta es el link a /cotizar con el servicio ya elegido: el
 * cotizador lo preselecciona por query (?servicio=). Mostrar el servicio
 * sin dejar pedirlo ahí mismo es lo que hacía a la sección plana.
 */
import IconoServicio from './IconoServicio.astro';
import { formatPriceRange } from '../lib/whatsapp';
import type { Service } from '../lib/types';

interface Props {
  servicio: Service;
  indice: number;
}

const { servicio, indice } = Astro.props;
const numero = String(indice + 1).padStart(2, '0');
---

<a
  href={`/cotizar?servicio=${encodeURIComponent(servicio.nombre)}`}
  class="tarjeta-servicio textura-papel"
  aria-label={`Cotizar ${servicio.nombre}`}
>
  <span class="filete" aria-hidden="true"></span>
  <span class="fantasma" aria-hidden="true">{numero}</span>

  <span class="cabecera">
    <IconoServicio nombre={servicio.icono} />
    <span class="precio">{formatPriceRange(servicio.precio_min, servicio.precio_max)}</span>
  </span>

  <span class="titulo">{servicio.nombre}</span>

  {
    servicio.descripcion && (
      <span class="desc">{servicio.descripcion}</span>
    )
  }

  <span class="accion">
    Cotizar este servicio
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h13M12 5l7 7-7 7" />
    </svg>
  </span>
</a>

<style>
  .tarjeta-servicio {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-linea);
    border-radius: var(--radius-card);
    background-color: var(--color-papel);
    padding: 1.5rem 1.4rem 1.3rem;
    color: inherit;
    text-decoration: none;
    transition:
      transform 220ms cubic-bezier(0.2, 0, 0, 1),
      border-color 180ms ease,
      box-shadow 220ms ease;
  }

  .tarjeta-servicio:hover {
    transform: translateY(-5px);
    border-color: var(--color-latón);
    box-shadow:
      0 1px 2px rgb(59 49 34 / 8%),
      0 14px 30px -14px rgb(59 49 34 / 28%);
  }

  /* Filete de marquetería: entra de izquierda a derecha al hover */
  .filete {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-latón), var(--color-latón-claro));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 280ms cubic-bezier(0.2, 0, 0, 1);
  }

  .tarjeta-servicio:hover .filete {
    transform: scaleX(1);
  }

  /* Número fantasma de taller, como los moldes numerados */
  .fantasma {
    position: absolute;
    top: 0.4rem;
    right: 0.9rem;
    font-family: var(--font-display);
    font-size: 3.4rem;
    font-weight: 600;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-latón-tenue);
    user-select: none;
  }

  .cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .precio {
    font-family: var(--font-display);
    font-size: 1.02rem;
    color: var(--color-latón);
    text-align: right;
  }

  .titulo {
    display: block;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--color-tinta);
    text-wrap: balance;
  }

  .desc {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-tinta-suave);
  }

  .accion {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 1.1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-caoba);
  }

  .accion svg {
    transition: transform 180ms cubic-bezier(0.2, 0, 0, 1);
  }

  .tarjeta-servicio:hover .accion {
    color: var(--color-tinta);
  }

  .tarjeta-servicio:hover .accion svg {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta-servicio,
    .filete,
    .accion svg {
      transition: none;
      transform: none;
    }

    .tarjeta-servicio:hover {
      transform: none;
    }

    .tarjeta-servicio:hover .filete {
      transform: scaleX(1);
    }
  }

  @supports not (-webkit-text-stroke: 1px #000) {
    .fantasma {
      color: var(--color-latón-tenue);
    }
  }
</style>
