---
/**
 * Imagen con marcador de carga.
 *
 * While the photo downloads, it shows a skeleton with the SAME shape as the
 * final image. When it finishes, it fades in. That way the page never jumps:
 * the space is reserved from the first paint.
 */
interface Props {
  src: string;
  alt: string;
  /** Proporción del marco. Define el alto antes de que la imagen exista. */
  ratio?: string;
  class?: string;
  sizes?: string;
  /** Eager para la primera imagen, lazy para el resto. */
  priority?: boolean;
}

const {
  src,
  alt,
  ratio = '4 / 3',
  class: clase = '',
  sizes,
  priority = false,
} = Astro.props;
---

<div
  class="marco-imagen js-imagen"
  style={`--proporcion:${ratio}`}
>
  <span class="esqueleto-imagen" aria-hidden="true"></span>
  <img
    src={src}
    alt={alt}
    class={clase}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
    sizes={sizes}
  />
</div>

<style>
  .marco-imagen {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: var(--proporcion);
    background-color: var(--color-papel-oscuro);
  }

  .marco-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.015);
    transition:
      opacity 420ms cubic-bezier(0.2, 0, 0, 1),
      transform 700ms cubic-bezier(0.2, 0, 0, 1);
  }

  /* El navegador ya la tenía en caché: se muestra sin transición */
  .marco-imagen img[data-inmediata] {
    opacity: 1;
    transform: none;
  }

  .marco-imagen img.cargada {
    opacity: 1;
    transform: none;
  }

  .esqueleto-imagen {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        transparent 20%,
        rgb(255 255 255 / 45%) 50%,
        transparent 80%
      ),
      var(--color-papel-oscuro);
    background-size: 200% 100%;
    animation: brillo-imagen 1.6s linear infinite;
  }

  .marco-imagen:has(img.cargada) .esqueleto-imagen,
  .marco-imagen:has(img[data-inmediata]) .esqueleto-imagen {
    opacity: 0;
    animation: none;
    transition: opacity 300ms ease;
  }

  @keyframes brillo-imagen {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marco-imagen img {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .esqueleto-imagen {
      animation: none;
    }
  }
</style>