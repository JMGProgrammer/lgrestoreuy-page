---
/**
 * Carrusel 3D de piezas para el hero: cards horizontales en un anillo con
 * perspectiva que gira en sentido horario. Cada card real muestra foto +
 * título + precio y lleva a su ficha; si hay menos de 8 piezas se completa
 * con marcos vacíos neutros (sin fotos inventadas) hasta ser 8.
 *
 * El giro es CSS puro; un script liviano lee el ángulo real de la animación
 * (Web Animations API) y transparenta las cards que pasan AL FRENTE para no
 * tapar el texto central. Al pasar el mouse o tabular se frena todo.
 */
import { formatUYU } from '../lib/whatsapp';
import type { PieceWithPhotos } from '../lib/types';

interface Props {
  piezas: PieceWithPhotos[];
}

const TOTAL = 8;

const { piezas } = Astro.props;
const reales = piezas.filter((p) => p.fotos.length > 0).slice(0, TOTAL);
const vacias = Math.max(0, TOTAL - reales.length);
---

<div class="carrusel3d" data-carrusel3d>
  <div class="inclinacion">
  <div class="anillo3d" data-anillo3d>
    {reales.map((pieza, i) => {
      const foto = pieza.fotos[0];
      const precio = formatUYU(pieza.precio);
      return (
        <div class="pos3d" style={`--gi:${(i * 360) / TOTAL}deg`}>
          <a
            class="cara"
            data-cara3d
            data-idx={i}
            href={`/piezas/${pieza.slug}`}
            title={precio ? `${pieza.titulo} — ${precio}` : pieza.titulo}
            aria-label={`Ver ficha de ${pieza.titulo}`}
          >
            <span class="cara-frente cara-frente--foto" aria-hidden="false">
              <img src={foto.url} alt="" loading="lazy" decoding="async" />
              <span class="cara-pie">
                <span class="cara-titulo">{pieza.titulo}</span>
                {precio && <span class="cara-precio">{precio}</span>}
              </span>
            </span>
            <span class="cara-dorso" aria-hidden="true">
              <span class="dorso-marca">L&amp;G</span>
              <span class="dorso-sub">Restauración</span>
            </span>
          </a>
        </div>
      );
    })}
    {Array.from({ length: vacias }, (_, k) => (
      <div class="pos3d" style={`--gi:${(((reales.length + k) * 360) / TOTAL).toFixed(1)}deg`}>
        <a
          class="cara"
          data-cara3d
          data-idx={reales.length + k}
          href="/piezas"
          aria-label="Ver piezas en venta"
        >
          <span class="cara-frente cara-frente--vacia">
            <span class="cara-vacia-texto">Próximamente</span>
          </span>
          <span class="cara-dorso" aria-hidden="true">
            <span class="dorso-marca">L&amp;G</span>
            <span class="dorso-sub">Restauración</span>
          </span>
        </a>
      </div>
    ))}
  </div>
  </div>
</div>

<style>
  .carrusel3d {
    --ancho-cara: 20rem;
    --alto-cara: 13.5rem;
    --rz: 32rem;
    --tilt: -24deg;
    perspective: 150rem;
    overflow: hidden;
    /* El anillo sube un poco para que abajo no se corte. */
    translate: 0 -2rem;
  }

  .anillo3d {
    position: relative;
    height: 54rem;
    transform-style: preserve-3d;
    animation: giro-y 55s linear infinite;
  }

  /*
    Inclinación de noria: el frente baja y el fondo sube, así las cards
    enmarcan el texto (arriba, costados, abajo) en vez de cruzarlo por
    el medio. Va en un envoltorio porque la animación pisa el transform.
  */
  .inclinacion {
    transform: rotateX(var(--tilt));
    transform-style: preserve-3d;
  }

  .pos3d {
    position: absolute;
    left: 50%;
    top: 50%;
    /* Tamaño cero: el giro pivota justo en el centro del anillo. Con el
       ancho de la card, el centro quedaba corrido y todo desfasaba. */
    width: 0;
    height: 0;
    transform: rotateY(var(--gi)) translateZ(var(--rz));
    /* Sin esto los hijos se aplanan y el dorso sale espejado. */
    transform-style: preserve-3d;
  }

  .cara {
    display: block;
    position: relative;
    width: var(--ancho-cara);
    height: var(--alto-cara);
    margin-left: calc(var(--ancho-cara) / -2);
    margin-top: calc(var(--alto-cara) / -2);
    transform-style: preserve-3d;
    color: inherit;
    text-decoration: none;
  }

  /*
    Dos caras: el frente con la foto y el dorso con la marca. Cada una se
    oculta sola cuando mira para el otro lado, así atrás se ve el dorso
    (nunca un texto espejado) y no hace falta esconder cards por JS.
  */
  .cara-frente,
  .cara-dorso {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .cara-frente--foto {
    border: 1px solid var(--color-linea);
    background: var(--color-papel);
    box-shadow: 0 18px 36px -18px rgb(59 49 34 / 50%);
  }

  .cara-frente--vacia {
    display: grid;
    place-items: center;
    border: 1.5px dashed var(--color-latón);
    background: rgb(251 247 239 / 55%);
  }

  .cara-dorso {
    display: grid;
    place-content: center;
    gap: 0.15rem;
    border: 1px solid var(--color-latón);
    outline: 3px solid var(--color-nogal);
    outline-offset: 3px;
    background: var(--color-papel);
    transform: rotateY(180deg);
    text-align: center;
  }

  .dorso-marca {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--color-tinta);
  }

  .dorso-sub {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-tinta-suave);
  }

  .cara-frente--foto img {
    display: block;
    width: 100%;
    height: calc(var(--alto-cara) - 3.4rem);
    object-fit: cover;
  }

  .cara-pie {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
  }

  .cara-titulo {
    font-family: var(--font-display);
    font-size: 1.05rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-tinta);
  }

  .cara-precio {
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--color-latón);
  }

  .cara-vacia-texto {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-tinta-tenue);
  }

  @keyframes giro-y {
    to {
      transform: rotateY(-360deg);
    }
  }

  /* El giro no se detiene: ni hover ni foco lo frenan. */

  @media (max-width: 40rem) {
    .carrusel3d {
      --ancho-cara: 13.5rem;
      --alto-cara: 10.5rem;
      --rz: 17rem;
      --tilt: -10deg;
    }

    .anillo3d {
      height: 22rem;
    }

    .cara-frente--foto img {
      height: calc(var(--alto-cara) - 3rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .anillo3d {
      animation: none;
    }
  }
</style>

<script>
  /**
   * Transparenta las cards que pasan al frente para no tapar el texto.
   * Las de atrás muestran su dorso (nunca un texto espejado), así que no
   * se oculta ninguna: las 8 se ven siempre. Lee el progreso real de la
   * animación CSS (Web Animations API). Un solo handler para todos los
   * carruseles de la página.
   */
  function iniciarCarruseles3d() {
    const conMovimiento = !window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    document
      .querySelectorAll<HTMLElement>('[data-carrusel3d]:not([data-listo])')
      .forEach((raiz) => {
        raiz.dataset.listo = 'si';

        const anillo =
          raiz.querySelector<HTMLElement>('[data-anillo3d]');
        const caras = Array.from(
          raiz.querySelectorAll<HTMLElement>('[data-cara3d]'),
        );
        if (!anillo || caras.length === 0) return;

        const total = caras.length;
        const animacion = conMovimiento
          ? anillo.getAnimations()[0]
          : undefined;

        // Sin animación (reduced-motion) no hay nada que seguir.
        if (!animacion || !animacion.effect) return;

        const efecto = animacion.effect as KeyframeEffect;
        const duracion = efecto.getTiming().duration;
        // Ventana del fantasma: solo bien al frente, sólida a los 72°.
        const VENTANA = Math.PI * 0.4;

        const pintar = () => {
          // En pausa (hover) los valores quedan fijos: no se recalcula.
          if (animacion.playState === 'running') {
            const tiempo = animacion.currentTime;
            const progreso =
              typeof tiempo === 'number' &&
              typeof duracion === 'number' &&
              duracion > 0
                ? (((tiempo % duracion) + duracion) % duracion) / duracion
                : 0;

            caras.forEach((cara) => {
              const i = Number(cara.dataset.idx ?? '0');
              // El giro va a -360°: 0 es el frente, 0.5 es atrás.
              const vuelta = (((i / total - progreso) % 1) + 1) % 1;
              // Distancia angular al frente (0..PI).
              const d = Math.min(vuelta, 1 - vuelta) * Math.PI * 2;
              const t = Math.min(1, d / VENTANA);
              const suave = t * t * (3 - 2 * t);
              cara.style.opacity = (0.12 + 0.88 * suave).toFixed(2);
            });
          }

          requestAnimationFrame(pintar);
        };

        requestAnimationFrame(pintar);
      });
  }

  document.addEventListener('astro:page-load', iniciarCarruseles3d);
  iniciarCarruseles3d();
</script>
