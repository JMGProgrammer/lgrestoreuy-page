---
/**
 * Fondo del hero: una foto propia del taller, muy difusa y con poca luz.
 *
 * Va al primer plano en la carga pero con `fetchpriority="low"` y
 * `decoding="async"`: es ambiente, no contenido. Si nadie sube una foto se
 * cae a una textura de papel y madera generada con CSS, para que el bloque
 * nunca se vea vacío.
 *
 * La foto no se guarda suelta en /public/ a propósito. Todo el contenido
 * del sitio lo carga el cliente desde /admin, y una foto de relleno en el
 * repositorio sería lo único que el cliente no puede cambiar.
 */
interface Props {
  url?: string | null;
}

const { url } = Astro.props;

/**
 * Sin foto del taller se usa una textura de madera que va con el repo. Es un
 * dibujo, no una foto de stock: no inventa nada del taller ni hay que
 * buscar de quién es la licencia. El cliente la reemplaza desde
 * /admin → Contenido cuando tenga una foto propia.
 */
const IMAGEN_POR_DEFECTO = '/portada.svg';
const fuente = url || IMAGEN_POR_DEFECTO;
---

<div class="fondo-portada" aria-hidden="true">
  <img
    src={fuente}
    alt=""
    class="fondo-portada__foto"
    loading="eager"
    decoding="async"
    fetchpriority="low"
  />
</div>

<style>
  .fondo-portada {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  /*
    El desenfoque se come los bordes, así que la foto va más grande que su
    caja: 10% de margen en cada lado contra 1.5rem de radio. Sin ese
    margen se ven los bordes transparentes del desenfoque.
  */
  .fondo-portada__foto {
    position: absolute;
    top: -10%;
    left: -10%;
    width: 120%;
    height: 120%;
    object-fit: cover;
    /*
      El sepia no es decoración: es lo que hace que cualquier foto que suba
      el cliente entre en la paleta del sitio. Sin él, una foto fría o con
      luz de tubo queda como una mancha gris sobre un fondo crema. Con
      sepia queda cálida pase lo que pase, y a esta altura de desenfoque
      nadie lo lee como filtro.
    */
    filter: blur(1.15rem) saturate(0.7) sepia(0.42) contrast(0.95);
    opacity: 0.8;
    transform: translateZ(0);
  }

  /*
    Velo por encima. Antes tapaba la foto entera del lado izquierdo: el
    titular queda en un lavado de crema opaco, y a la derecha, donde está
    la foto de antes/después, no se veía nada. La foto se perdía.

    Ahora solo se lava fuerte donde va el texto y se abre rápido hacia la
    derecha, que es donde la foto tiene que leerse.
  */
  .fondo-portada::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      96deg,
      rgb(251 247 239 / 90%) 0%,
      rgb(251 247 239 / 74%) 30%,
      rgb(245 239 228 / 30%) 58%,
      rgb(245 239 228 / 12%) 100%
    );
  }

  /*
    Color detras de la imagen. No se ve en condiciones normales, pero si la
    imagen tarda o falla el bloque no queda en blanco.
  */
  .fondo-portada {
    background-color: var(--color-papel-oscuro);
  }
</style>