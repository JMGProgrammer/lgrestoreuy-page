---
/**
 * Anillo orbital del hero: las piezas giran en sentido horario alrededor
 * del texto central. Cada una muestra una sola foto (la mejor, la portada)
 * y lleva a su ficha.
 *
 * El anillo rota y cada satélite contrarota el mismo ángulo, así las fotos
 * quedan siempre verticales. Puro CSS, sin JavaScript. Sin piezas no se
 * renderiza nada: nada de relleno.
 */
import { formatUYU } from '../lib/whatsapp';
import type { PieceWithPhotos } from '../lib/types';

interface Props {
  piezas: PieceWithPhotos[];
}

const { piezas } = Astro.props;
const anillo = piezas.filter((p) => p.fotos.length > 0);
---

{
  anillo.length > 0 && (
    <div class="orbita" aria-label="Piezas en venta">
      {anillo.map((pieza, i) => {
        const foto = pieza.fotos[0];
        const precio = formatUYU(pieza.precio);
        return (
          <span
            class="pos"
            style={`--a:${((i * 360) / anillo.length).toFixed(1)}deg`}
          >
            <a
              class="satelite"
              href={`/piezas/${pieza.slug}`}
              title={precio ? `${pieza.titulo} — ${precio}` : pieza.titulo}
              aria-label={`Ver ficha de ${pieza.titulo}`}
            >
              <img src={foto.url} alt="" loading="lazy" decoding="async" />
            </a>
          </span>
        );
      })}
    </div>
  )
}

<style>
  /*
    El anillo rota y cada satélite contrarota el mismo ángulo, así las
    fotos quedan siempre verticales. Puro CSS, sin JavaScript.
  */
  .orbita {
    --r: clamp(11rem, 34vmin, 21rem);
    --t: clamp(3.5rem, 9vmin, 5.5rem);
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 0;
    width: 0;
    height: 0;
    animation: giro-horario 90s linear infinite;
  }

  .orbita .pos {
    position: absolute;
    left: 0;
    top: 0;
    transform: rotate(var(--a)) translateX(var(--r));
  }

  .orbita .satelite {
    display: block;
    width: var(--t);
    height: var(--t);
    margin-left: calc(var(--t) / -2);
    margin-top: calc(var(--t) / -2);
    overflow: hidden;
    border: 2px solid var(--color-papel);
    border-radius: 999px;
    outline: 1px solid var(--color-latón);
    box-shadow: 0 10px 24px -12px rgb(59 49 34 / 45%);
    background: var(--color-papel-oscuro);
    animation: giro-antihorario 90s linear infinite;
  }

  .orbita .satelite img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms cubic-bezier(0.2, 0, 0, 1);
  }

  .orbita .satelite:hover img {
    transform: scale(1.12);
  }

  @keyframes giro-horario {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes giro-antihorario {
    to {
      transform: rotate(-360deg);
    }
  }

  /* Quietos al pasar el mouse o tabular: si no, no hay quién cliquee */
  :global(.hero-centro:hover) .orbita,
  :global(.hero-centro:hover) .orbita .satelite,
  :global(.hero-centro:focus-within) .orbita,
  :global(.hero-centro:focus-within) .orbita .satelite {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .orbita,
    .orbita .satelite {
      animation: none;
    }
  }
</style>
