---
/**
 * Foto del hero, enmarcada como lámina de museo.
 *
 * PROVISORIA: es una cómoda de museo (CC0, Rawpixel/Openverse, ver abajo),
 * no un trabajo del taller. Se reemplaza por fotos reales del cliente en
 * cuanto suba las suyas desde /admin. Fuente registrada en la memoria del
 * proyecto (02-Projects/LG-Restore-Uy/README.md).
 *
 * Fuente: https://www.rawpixel.com/image/14264777/commode
 * Licencia: CC0 (dominio público, uso comercial permitido, sin atribución).
 * Vía: https://api.openverse.org/v1/images/ (filtro license_type=commercial).
 */
---

<figure class="hero-foto">
  <span class="hero-halo" aria-hidden="true"></span>
  <span class="hero-marco">
    <img
      src="/hero-comoda.webp"
      alt="Cómoda antigua de madera con marquetería, tapa de mármol y bronces dorados"
      width="1024"
      height="853"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </span>
</figure>

<style>
  .hero-foto {
    position: relative;
    width: 100%;
    max-width: 26rem;
    margin-inline: auto;
  }

  /* Resplandor cálido detrás, como el de la referencia */
  .hero-halo {
    position: absolute;
    inset: -12% -18%;
    background: radial-gradient(
      ellipse at center,
      rgb(199 154 94 / 38%) 0%,
      rgb(199 154 94 / 12%) 55%,
      transparent 72%
    );
    pointer-events: none;
  }

  /* Paspartú + marco de taller */
  .hero-marco {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-linea);
    outline: 5px solid var(--color-nogal);
    outline-offset: 7px;
    border-radius: 2px;
    background: var(--color-papel);
    box-shadow:
      0 1px 2px rgb(59 49 34 / 12%),
      0 24px 48px -20px rgb(59 49 34 / 35%);
  }

  .hero-marco img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 1024px) {
    .hero-foto {
      max-width: none;
    }
  }
</style>
