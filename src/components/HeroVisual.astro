---
/**
 * Contenedor del visual del hero.
 *
 * La foto provisoria se sacó a pedido: queda solo el halo cálido como
 * ambiente, manteniendo la estructura de dos columnas del hero. Cuando el
 * cliente suba fotos reales, acá va una pieza destacada del taller.
 */
---

<div class="hero-flota" aria-hidden="true">
  <span class="hero-halo"></span>
</div>

<style>
  .hero-flota {
    position: relative;
    width: 100%;
    max-width: 28rem;
    min-height: 12rem;
    margin-inline: auto;
  }

  /* Resplandor cálido de ambiente */
  .hero-halo {
    position: absolute;
    inset: -10% -14%;
    background: radial-gradient(
      ellipse at center,
      rgb(199 154 94 / 45%) 0%,
      rgb(199 154 94 / 14%) 55%,
      transparent 72%
    );
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .hero-flota {
      max-width: none;
      min-height: 20rem;
    }
  }
</style>
