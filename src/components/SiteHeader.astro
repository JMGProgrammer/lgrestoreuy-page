---
interface Props {
  siteName: string;
}

const { siteName } = Astro.props;

const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/piezas', label: 'Piezas' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header sticky top-0 z-40 border-b border-linea bg-papel/95 backdrop-blur">
  {/*
    Tres columnas y no flex con justify-between: con flex, el ancho del logo
    empuja el menú y nunca queda centrado de verdad. Con la columna 1fr en el
    medio, el menú se centra siempre, se llame como se llame el taller.
  */}
  <div
    class="mx-auto grid max-w-6xl grid-cols-[auto_1fr_auto] items-center gap-6 px-4 py-4"
  >
    <a href="/" class="group flex items-baseline gap-2">
      <span class="font-display text-xl font-semibold tracking-tight text-tinta">
        {siteName}
      </span>
      <span
        class="hidden text-[0.6rem] uppercase tracking-[0.25em] text-latón sm:inline"
      >
        Restauración
      </span>
    </a>

    <nav
      class="hidden items-center justify-self-center gap-8 md:flex"
      aria-label="Principal"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'nav-enlace text-sm',
              isActive(item.href)
                ? 'text-tinta'
                : 'text-tinta-suave hover:text-tinta',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center justify-self-end gap-3">
      <a href="/cotizar" class="btn-principal">
        Cotizar
        <svg
          class="btn-flecha"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h13M12 5l7 7-7 7"></path>
        </svg>
      </a>

      <!-- Menú móvil con <details>: sin JavaScript -->
      <details class="relative md:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded border border-linea text-tinta-suave"
          aria-label="Abrir menú"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-11 w-52 rounded border border-linea bg-papel p-2 sombra-vintage"
          aria-label="Móvil"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded px-3 py-2 text-sm hover:bg-papel-oscuro hover:text-tinta',
                  isActive(item.href)
                    ? 'bg-papel-oscuro text-tinta'
                    : 'text-tinta-suave',
                ]}
              >
                {item.label}
              </a>
            ))
          }
          {/*
          Sin botón de Cotizar acá adentro a propósito: el de la barra está
          siempre visible, también en el celular. Dos "Cotizar" en pantalla
          es decidir cuál apretar.
        */}
        </nav>
      </details>
    </div>
  </div>
  <div class="rule-dorada"></div>
</header>