---
/**
 * Layout del panel. Herramienta de trabajo: barra superior fija, navegación
 * lateral en desktop y una barra inferior en el celular (el pulgar llega ahí).
 */
import { getCurrentUser, getSupabaseConSesion } from '../lib/supabase/server';
import Icon from '../components/admin/Icon.astro';
import Toasts from '../components/admin/Toasts.astro';
import '../styles/global.css';
import '../styles/admin.css';

interface Props {
  titulo: string;
  subtitulo?: string;
  /** Muestra el saludo arriba. Para el resumen. */
  saludo?: boolean;
}

const { titulo, subtitulo, saludo: conSaludo = false } = Astro.props;
const usuario = await getCurrentUser(Astro.request, Astro.cookies);

/**
 * La papelera vive en el nav, como cualquier sección: una vez que el
 * cliente descartó algo por accidente, tiene que encontrarla sin pasar
 * por Cotizaciones. El badge cuenta lo que espera ser purgado.
 */
let papeleraPendiente = 0;
if (usuario) {
  try {
    const supabaseParaNav = getSupabaseConSesion(Astro.request, Astro.cookies);
    const { count } = await supabaseParaNav
      .from('quotes_borradas')
      .select('id', { count: 'exact', head: true });
    papeleraPendiente = count ?? 0;
  } catch {
    // El nav no puede caerse por el badge: sin count queda sin número y listo.
  }
}

const secciones = [
  { href: '/admin', label: 'Resumen', icono: 'resumen', movil: true },
  { href: '/admin/cotizaciones', label: 'Cotizaciones', icono: 'cotizaciones', movil: true },
  { href: '/admin/piezas', label: 'Piezas', icono: 'piezas', movil: true },
  { href: '/admin/servicios', label: 'Servicios', icono: 'servicios', movil: true },
  { href: '/admin/galeria', label: 'Galería', icono: 'galeria', movil: true },
  { href: '/admin/contenido', label: 'Contenido', icono: 'contenido', movil: true },
  { href: '/admin/papelera', label: 'Papelera', icono: 'papelera', movil: true },
];

/** Saludo con la hora: el taller trabaja de día, el panel se usa de día. */
function saludo() {
  const hora = new Date().getHours();
  if (hora < 13) return 'Buen día';
  if (hora < 19) return 'Buenas tardes';
  return 'Buenas noches';
}

const actual = Astro.url.pathname;
const esActiva = (href: string) =>
  href === '/admin' ? actual === '/admin' : actual.startsWith(href);

const iconoNav: Record<string, string> = {
  resumen:
    '<rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" />',
  cotizaciones:
    '<path d="M5 4h14v16l-3-2-2 2-2-2-2 2-2-2-3 2V4Z" /><path d="M9 9h6M9 13h4" />',
  piezas:
    '<rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="1.6" /><path d="m4 18 5-5 4 4 2-2 5 5" />',
  servicios:
    '<path d="M4 7h16M4 12h10M4 17h7" /><path d="M17 15v6M14 18h6" />',
  galeria:
    '<rect x="3" y="5" width="8" height="14" rx="1.5" /><rect x="13" y="5" width="8" height="14" rx="1.5" />',
  contenido:
    '<rect x="4" y="3" width="16" height="18" rx="2" /><path d="M8 8h8M8 12h8M8 16h5" />',
  papelera:
    '<path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/>',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Panel</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,600&display=swap"
    />
  </head>

  <body class="admin">
    <!--
      Fondo de ondas. Va primero y detrás de todo (z-index: -1), así que
      nunca tapa un control ni roba un click.
    -->
    <div class="ui-olas" aria-hidden="true"></div>

    <!-- Barra superior: siempre visible, incluso al hacer scroll -->
    <header class="sticky top-0 z-30 border-b border-ui-borde bg-ui-panel">
      <div class="mx-auto flex h-14 max-w-[1400px] items-center gap-3 px-3 sm:px-5">
        <a href="/admin" class="flex items-baseline gap-2">
          <span class="font-display text-base font-semibold text-ui-texto">
            L&amp;G
          </span>
          <span class="text-[0.6875rem] font-medium tracking-wide text-ui-texto-3">
            Panel
          </span>
        </a>

        <div class="ml-auto flex items-center gap-2">
          <a href="/" target="_blank" rel="noopener" class="ui-btn ui-btn-fantasma ui-btn-sm" aria-label="Ver la web">
            <Icon nombre="ojo" clase="size-4 sm:hidden" />
            <span class="hidden sm:inline">Ver la web</span>
            <Icon nombre="flecha" clase="hidden size-3.5 sm:block" />
          </a>

          {
            usuario && (
              <form method="post" action="/api/admin/logout">
                <button
                  type="submit"
                  class="ui-btn ui-btn-neutro ui-btn-sm"
                  title={usuario.email}
                >
                  Salir
                </button>
              </form>
            )
          }
        </div>
      </div>
    </header>

    <div class="mx-auto flex max-w-[1400px] gap-6 px-3 py-4 sm:px-5 sm:py-6">
      <!-- Navegación lateral (desktop) -->
      <nav class="hidden w-48 shrink-0 md:block" aria-label="Secciones">
        <ul class="sticky top-20 space-y-0.5">
          {
            secciones.map((seccion) => (
              <li>
                <a
                  href={seccion.href}
                  aria-current={esActiva(seccion.href) ? 'page' : undefined}
                  class:list={[
                    'flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition-colors',
                    esActiva(seccion.href)
                      ? 'bg-ui-texto font-medium text-ui-panel'
                      : 'text-ui-texto-2 hover:bg-ui-panel-2 hover:text-ui-texto',
                  ]}
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={iconoNav[seccion.icono]}
                  />
                  {seccion.label}
                  {seccion.href === '/admin/papelera' && papeleraPendiente > 0 && (
                    <span class="ml-auto rounded-full bg-ui-peligro/15 px-1.5 py-0.5 text-[0.625rem] font-semibold text-ui-peligro">
                      {papeleraPendiente > 9 ? '9+' : papeleraPendiente}
                    </span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <main class="min-w-0 flex-1 pb-20 md:pb-0">
        <div class="mb-5">
          {
            conSaludo && (
              <p class="ui-seccion-titulo mb-1">{saludo()}</p>
            )
          }
          <h1 class="text-xl font-semibold tracking-tight text-ui-texto">{titulo}</h1>
          {subtitulo && <p class="mt-1 text-sm text-ui-texto-2">{subtitulo}</p>}
        </div>

        <slot />
      </main>
    </div>

    <!-- Barra inferior (celular): las 7 secciones, una fila de pulgar. -->
    <nav
      class="fixed inset-x-0 bottom-0 z-30 border-t border-ui-borde bg-ui-panel/95 backdrop-blur md:hidden"
      aria-label="Secciones"
    >
      <ul class="mx-auto grid max-w-lg grid-cols-7">
        {
          secciones
            .filter((s) => s.movil)
            .map((seccion) => (
              <li>
                <a
                  href={seccion.href}
                  aria-current={esActiva(seccion.href) ? 'page' : undefined}
                  class:list={[
                    'relative flex flex-col items-center gap-0.5 px-0.5 py-2.5 text-[0.5625rem] leading-tight transition-colors',
                    esActiva(seccion.href)
                      ? 'text-ui-acento'
                      : 'text-ui-texto-3',
                  ]}
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={iconoNav[seccion.icono]}
                  />
                  {seccion.label}
                  {seccion.href === '/admin/papelera' && papeleraPendiente > 0 && (
                    <span class="absolute right-3 top-2 inline-block h-1.5 w-1.5 rounded-full bg-ui-peligro" aria-hidden="true"></span>
                    <span class="sr-only">Hay algo esperando en la papelera</span>
                  )}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>

    <!--
      Confirmación de envíos peligrosos. Cualquier form con data-confirm
      lo abre antes de enviar (lo instala scripts/admin.ts). Reemplaza al
      confirm() del navegador: la CSP de producción bloquea los handlers
      inline, así que el de la galería/servicios no va a andar nunca acá.
    -->
    <div class="ui-fondo" data-confirm-dialog hidden>
      <div
        class="ui-dialogo p-5"
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="titulo-confirmar"
        aria-describedby="texto-confirmar"
      >
        <h2 id="titulo-confirmar" class="text-base font-semibold text-ui-texto">
          Confirmar acción
        </h2>
        <p id="texto-confirmar" class="mt-1.5 text-sm text-ui-texto-2"></p>
        <div class="mt-5 flex flex-wrap justify-end gap-2">
          <button type="button" class="ui-btn ui-btn-neutro" data-confirmar-cancelar>
            Volver
          </button>
          <button type="button" class="ui-btn ui-btn-peligro" data-confirmar-ok>
            Confirmar
          </button>
        </div>
      </div>
    </div>

    <Toasts />

    <!--
      Cambios sin guardar: aparece al intentar cambiar de sección con el
      borrador abierto. Ofrece guardar, descartar o quedarse.
    -->
    <div
      class="ui-fondo"
      x-show="$store.cambios.dialogo"
      x-cloak
      @click.self="$store.cambios.cerrarDialogo()"
      x-transition.opacity.duration.150ms
    >
      <div
        class="ui-dialogo p-5"
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="titulo-sin-guardar"
        @click.outside="$store.cambios.cerrarDialogo()"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 translate-y-3 sm:scale-95"
        x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
      >
        <h2 id="titulo-sin-guardar" class="text-base font-semibold text-ui-texto">
          Tenés cambios sin guardar
        </h2>
        <p class="mt-1.5 text-sm text-ui-texto-2">
          Editaste <span class="font-medium text-ui-texto" x-text="$store.cambios.etiqueta"></span>
          y no lo guardaste. Si salís de esta sección, se pierde.
        </p>

        <div class="mt-5 flex flex-wrap justify-end gap-2">
          <button
            type="button"
            class="ui-btn ui-btn-neutro"
            @click="$store.cambios.cerrarDialogo()"
          >
            Seguir editando
          </button>
          <button
            type="button"
            class="ui-btn ui-btn-peligro"
            @click="$store.cambios.alDescartar?.(); $store.cambios.cerrarDialogo()"
          >
            Descartar
          </button>
          <button
            type="button"
            class="ui-btn ui-btn-acento"
            @click="(async () => { await $store.cambios.alGuardar?.(); const d = $store.cambios.destino; $store.cambios.limpiar(); if (d) window.location.href = d; })()"
          >
            Guardar y salir
          </button>
        </div>
      </div>
    </div>
  </body>
</html>

<script>
  import '../scripts/admin';
</script>