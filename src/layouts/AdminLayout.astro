---
/**
 * Layout del panel. Distinto del público: sin footer, sin botón de WhatsApp,
 * con navegación lateral y sin cache (el admin ve lo que está editando).
 */
import { getCurrentUser } from '../lib/supabase/server';
import '../styles/global.css';

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
const usuario = await getCurrentUser(Astro.request, Astro.cookies);

const secciones = [
  { href: '/admin', label: 'Resumen' },
  { href: '/admin/cotizaciones', label: 'Cotizaciones' },
  { href: '/admin/piezas', label: 'Piezas' },
  { href: '/admin/servicios', label: 'Servicios' },
  { href: '/admin/galeria', label: 'Galería' },
  { href: '/admin/contenido', label: 'Contenido' },
];

const actual = Astro.url.pathname;
const esActiva = (href: string) =>
  href === '/admin' ? actual === '/admin' : actual.startsWith(href);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Panel</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap"
    />
  </head>

  <body class="min-h-screen bg-lino">
    <header class="border-b border-linea bg-papel">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
        <div class="flex items-baseline gap-3">
          <span class="font-display text-lg font-semibold text-tinta">Panel</span>
          <a
            href="/"
            class="text-xs text-tinta-suave underline decoration-latón underline-offset-4 hover:text-tinta"
          >
            Ver la web ↗
          </a>
        </div>

        {
          usuario && (
            <form method="post" action="/api/admin/logout">
              <div class="flex items-center gap-3">
                <span class="hidden text-xs text-tinta-tenue sm:inline">
                  {usuario.email}
                </span>
                <button
                  type="submit"
                  class="rounded border border-linea px-3 py-1.5 text-xs text-tinta-suave transition-colors hover:border-latón hover:text-tinta"
                >
                  Salir
                </button>
              </div>
            </form>
          )
        }
      </div>
    </header>

    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-6 md:flex-row">
      <nav
        class="shrink-0 md:w-52"
        aria-label="Secciones del panel"
      >
        <ul class="flex gap-2 overflow-x-auto md:flex-col md:gap-1">
          {
            secciones.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={esActiva(item.href) ? 'page' : undefined}
                  class:list={[
                    'block whitespace-nowrap rounded px-3 py-2 text-sm transition-colors',
                    esActiva(item.href)
                      ? 'bg-nogal text-papel'
                      : 'text-tinta-suave hover:bg-papel-oscuro hover:text-tinta',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <main class="min-w-0 flex-1">
        <h1 class="font-display text-2xl text-tinta">{titulo}</h1>
        <slot />
      </main>
    </div>
  </body>
</html>